---
import Button from "./ui/Button.astro";
import Logo from "./ui/Logo.astro";
import { nav } from "../data/nav";
import { site, whatsappLink } from "../data/site";
import { CTA } from "../data/cta";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const menuLinks = [...nav.primary, ...nav.secondary];
---

<header class="site-header" data-site-header>
  <div class="container site-header__bar">
    <a class="site-header__brand" href="/" aria-label="Renol Foods, home">
      <Logo />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {
          nav.primary.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <div class="site-header__cta">
        <Button href={whatsappLink()} target="_blank" rel="noopener noreferrer">{CTA.chat.label}</Button>
      </div>
      <button
        type="button"
        class="menu-toggle"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<!-- Sibling of <header>, never inside it: the header's backdrop-filter would otherwise become the
     containing block of this fixed panel and clip it. -->
<div class="menu-root" data-menu-root>
  <div class="menu-backdrop" data-menu-backdrop aria-hidden="true"></div>
  <div id="mobile-menu" class="menu-panel" role="dialog" aria-modal="true" aria-label="Site menu" data-lenis-prevent inert>
    <div class="menu-panel__head">
      <a href="/" aria-label="Renol Foods, home"><Logo /></a>
      <button type="button" class="menu-close" aria-label="Close menu" data-menu-close>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4 4l12 12M16 4 4 16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <nav class="menu-panel__nav" aria-label="Mobile">
      <ul>
        {
          menuLinks.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="menu-panel__foot">
      <p>Contact</p>
      <ul>
        <li>
          <a href={whatsappLink()} target="_blank" rel="noopener noreferrer">{CTA.chat.label}</a>
        </li>
        <li>
          <a href={site.mapUrl} target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
        </li>
        {
          site.phones.map((p) => (
            <li>
              <a href={`tel:${p.tel}`}>Call {p.display}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgba(11, 11, 13, 0.86);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line-soft);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: var(--header-h);
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    flex: none;
    min-height: var(--tap);
  }
  .site-header__nav {
    display: none;
  }
  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--s-3);
    border-radius: var(--r-pill);
    color: var(--ink-2);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color var(--dur-1) var(--ease-out), background-color var(--dur-1) var(--ease-out);
  }
  .site-header__nav a:hover {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.08);
  }
  .site-header__nav a[aria-current="page"] {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.12);
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .site-header__cta {
    display: none;
  }

  .menu-toggle,
  .menu-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--tap);
    block-size: var(--tap);
    border: 1px solid var(--line);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink);
    cursor: pointer;
  }
  .menu-toggle__bars {
    display: grid;
    gap: 5px;
    inline-size: 1.125rem;
  }
  .menu-toggle__bars span {
    block-size: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  @media (min-width: 1024px) {
    .site-header__nav {
      display: block;
    }
    .site-header__cta {
      display: block;
    }
    .menu-toggle,
    .menu-root {
      display: none;
    }
  }

  /* Mobile menu */
  .menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    background: rgba(0, 0, 0, 0.62);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-1) var(--ease-out);
  }
  .menu-panel {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    z-index: calc(var(--z-menu) + 1);
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    inline-size: min(88vw, 22rem);
    block-size: 100dvh;
    padding: var(--s-4) var(--s-6) calc(var(--s-6) + env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--panel);
    border-inline-start: 1px solid var(--line);
    visibility: hidden;
    transform: translate3d(100%, 0, 0);
    transition:
      transform var(--dur-2) var(--ease-out),
      visibility 0s linear var(--dur-2);
  }
  .menu-root[data-open="true"] .menu-backdrop {
    opacity: 1;
    pointer-events: auto;
  }
  .menu-root[data-open="true"] .menu-panel {
    visibility: visible;
    transform: none;
    transition:
      transform var(--dur-2) var(--ease-out),
      visibility 0s;
  }
  .menu-panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .menu-panel__nav ul,
  .menu-panel__foot ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu-panel__nav a {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    padding-inline: var(--s-2);
    border-bottom: 1px solid var(--line-soft);
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 500;
  }
  .menu-panel__nav a[aria-current="page"] {
    color: var(--accent);
  }
  .menu-panel__foot {
    margin-top: auto;
  }
  .menu-panel__foot p {
    margin-bottom: var(--s-2);
    color: var(--ink-3);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .menu-panel__foot a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: var(--s-2);
    color: var(--ink-2);
  }
</style>
