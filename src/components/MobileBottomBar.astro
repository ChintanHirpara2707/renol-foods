---
import CtaButton from "./ui/CtaButton.astro";
import { site } from "../data/site";

const waUrl = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`;
---

<nav class="bar" aria-label="Quick contact">
  <a class="bar__item" href={`tel:${site.phones[0].tel}`}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" />
    </svg>
    <span>Call</span>
  </a>
  <a class="bar__item" href={waUrl} target="_blank" rel="noopener noreferrer">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M.057 24l1.687-6.163A11.9 11.9 0 0 1 .157 11.89C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.82 11.82 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24Zm6.597-3.807A9.87 9.87 0 0 0 12.046 21.8c5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884 0 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981Z" />
    </svg>
    <span>WhatsApp</span>
  </a>
  <div class="bar__cta">
    <CtaButton placement="bar" />
  </div>
</nav>

<style>
  .bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: var(--z-bar);
    display: grid;
    grid-template-columns: 1fr 1fr 2fr;
    align-items: center;
    gap: var(--s-2);
    block-size: calc(var(--bar-h) + env(safe-area-inset-bottom, 0px));
    padding: var(--s-2) var(--s-3) calc(var(--s-2) + env(safe-area-inset-bottom, 0px));
    background: rgba(18, 18, 20, 0.96);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--line);
  }
  .bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: var(--tap);
    border-radius: 0.75rem;
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .bar__item:hover {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.08);
  }
  .bar__cta {
    display: flex;
  }
  .bar__cta :global(.btn) {
    flex: 1;
    padding-inline: var(--s-3);
    font-size: 0.875rem;
  }
  @media (min-width: 768px) {
    .bar {
      display: none;
    }
  }
</style>
