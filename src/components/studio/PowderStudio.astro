<script>
  import { initPowderStudio } from "../../scripts/studio";

  let cleanup: (() => void) | null = null;

  function boot() {
    const root = document.getElementById("powder-studio");
    if (!root) return;
    if (cleanup) cleanup();
    cleanup = initPowderStudio(root);
  }

  document.addEventListener("astro:page-load", boot);
  document.addEventListener("astro:before-swap", () => {
    if (cleanup) {
      cleanup();
      cleanup = null;
    }
  });

  // Fallback for direct page load if ViewTransitions is not used
  if (document.readyState === "complete" || document.readyState === "interactive") {
    boot();
  } else {
    document.addEventListener("DOMContentLoaded", boot);
  }
</script>
