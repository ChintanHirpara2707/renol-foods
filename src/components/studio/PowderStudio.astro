---
import CtaButton from "../ui/CtaButton.astro";
import { studioData } from "../../scripts/studio/data";
import { site } from "../../data/site";

const { items } = studioData();
const initial = items[Math.min(2, items.length - 1)];
---

<section class="ps" id="powder-studio" data-studio aria-roledescription="carousel" aria-label="Powder studio">
  <h1 class="sr-only">{site.tagline}</h1>

  <div class="ps-bgs" data-bgs aria-hidden="true"></div>

  <div class="ps-stage" data-stage>
    <div class="ps-ghost" data-ghost aria-hidden="true">{initial?.name.toUpperCase()}</div>
    <div class="ps-ring" data-ring></div>

    <div class="ps-cta ps-ui">
      <CtaButton placement="hero" />
    </div>

    <button class="ps-arrow ps-l ps-ui" type="button" data-prev aria-label="Previous product">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 5l-7 7 7 7"></path>
      </svg>
    </button>
    <button class="ps-arrow ps-r ps-ui" type="button" data-next aria-label="Next product">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <div class="ps-nameblock" aria-live="polite">
      <p class="ps-name" data-name>{initial?.name}</p>
      <p class="ps-sub" data-sub>{initial ? `${initial.cat} powder` : ""}</p>
    </div>

    <div class="ps-dots ps-ui" data-dots role="group" aria-label="Choose a powder"></div>

    <p class="ps-hint" data-hint>
      <i aria-hidden="true"></i>
      <span data-hint-text>Drag the fruit to turn it. Click it to open the product</span>
    </p>

    <a class="ps-cue ps-ui" href="#content-start">
      <span>Scroll to explore</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 5v14M19 12l-7 7-7-7"></path>
      </svg>
    </a>
  </div>

  <!-- Server-rendered list so every product is reachable without JavaScript -->
  <nav class="sr-only" aria-label="All powders" data-allnav>
    <ul>
      {
        items.map((p) => (
          <li>
            <a href={`/products/${p.slug}`}>{p.name} powder</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <script type="application/json" data-studio-data set:html={JSON.stringify(items)} />
</section>

<style is:global>
  .ps {
    --on: #140a00;
    position: relative;
    display: block;
    block-size: calc(100svh - var(--header-h));
    min-block-size: 30rem;
    overflow: clip;
    isolation: isolate;
    container-type: size;
    background: var(--bg);
    color: var(--ink);
  }
  @media (max-width: 767.98px) {
    .ps {
      block-size: calc(100svh - var(--header-h) - var(--bar-h) - env(safe-area-inset-bottom, 0px));
    }
  }

  /* One background layer per product, cross-faded */
  .ps-bgs {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--bg);
  }
  .ps-bg {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s ease;
    background: radial-gradient(62% 58% at 50% 44%, var(--glow) 0%, transparent 100%), var(--base);
  }
  .ps-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 50% 50%, transparent 55%, rgba(0, 0, 0, 0.55) 100%);
  }
  .ps-bg.on {
    opacity: 1;
  }

  /* Stage: vertical scroll always belongs to the page; only horizontal drags are ours */
  .ps-stage {
    --cw: clamp(150px, min(52cqw, 36cqh), 340px);
    position: absolute;
    inset: 0;
    z-index: 1;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
  }
  .ps-stage:active {
    cursor: grabbing;
  }

  .ps-ghost {
    position: absolute;
    left: 50%;
    top: 43cqh;
    z-index: 1;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    pointer-events: none;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(72px, min(19cqw, 34cqh), 300px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.15);
  }

  .ps-ring {
    position: absolute;
    left: 50%;
    top: 43cqh;
    z-index: 3;
    width: 0;
    height: 0;
    perspective: 1400px;
  }
  .ps-card {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--cw);
    height: calc(var(--cw) * 1.2);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: inherit;
    will-change: transform, opacity;
    -webkit-tap-highlight-color: transparent;
    filter: drop-shadow(0 28px 36px rgba(0, 0, 0, 0.45));
  }
  .ps-card:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 10px;
    border-radius: 28px;
  }
  .ps-fruit {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform-origin: 50% 62%;
    pointer-events: none;
  }

  .ps-cta {
    position: absolute;
    top: 16px;
    right: 24px;
    z-index: 9;
  }
  @container (max-width: 700px) {
    .ps-cta {
      right: 16px;
    }
  }

  .ps-nameblock {
    position: absolute;
    inset-inline: 0;
    bottom: 84px;
    z-index: 6;
    padding-inline: 16px;
    text-align: center;
    pointer-events: none;
  }
  .ps-name {
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(36px, min(7.5cqw, 10.5cqh), 96px);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  .ps-sub {
    margin: 8px 0 0;
    font-size: 16px;
    color: var(--ink-2);
  }

  .ps-hint {
    display: none;
    position: absolute;
    inset-inline: 0;
    bottom: 78px;
    z-index: 6;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0;
    padding-inline: 16px;
    font-size: 14px;
    color: var(--ink-2);
    text-align: center;
    pointer-events: none;
  }
  .ps-hint i {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    animation: ps-ping 2s infinite;
  }
  @keyframes ps-ping {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 70%, transparent);
    }
    80%,
    100% {
      box-shadow: 0 0 0 12px transparent;
    }
  }
  @container (min-height: 640px) {
    .ps-nameblock {
      bottom: 108px;
    }
    .ps-hint {
      display: flex;
    }
  }

  .ps-dots {
    position: absolute;
    inset-inline: 0;
    bottom: 52px;
    z-index: 7;
    display: flex;
    justify-content: center;
  }
  /* 24px hit area (WCAG 2.5.8); the visible dot is drawn by ::before */
  .ps-dot {
    position: relative;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    transition: width 0.35s;
  }
  .ps-dot::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.45);
    transform: translate(-50%, -50%);
    transition:
      width 0.35s,
      background 0.35s;
  }
  .ps-dot.on {
    width: 36px;
  }
  .ps-dot.on::before {
    width: 28px;
    background: var(--accent);
  }

  .ps-arrow {
    position: absolute;
    top: 43cqh;
    z-index: 8;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-top: -24px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.07);
    color: var(--ink);
    cursor: pointer;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .ps-arrow:hover {
    background: rgba(255, 255, 255, 0.16);
  }
  .ps-arrow svg {
    width: 20px;
    height: 20px;
  }
  .ps-l {
    left: 24px;
  }
  .ps-r {
    right: 24px;
  }
  @container (max-width: 700px) {
    .ps-arrow {
      display: none;
    }
  }

  .ps-cue {
    position: absolute;
    inset-inline: 0;
    bottom: 4px;
    z-index: 7;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: max-content;
    min-height: 44px;
    margin-inline: auto;
    padding-inline: 16px;
    font-size: 13px;
    color: var(--ink-2);
  }
  .ps-cue:hover {
    color: var(--ink);
  }
  .ps-cue svg {
    width: 16px;
    height: 16px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ps-bg {
      transition-duration: 0.01s;
    }
    .ps-hint i {
      animation: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { createFruitRenderer } from "../../scripts/studio/fruit-gl";
  import type { StudioProduct } from "../../scripts/studio/data";
  import { onPageLoad } from "../../scripts/lifecycle";
  import { createProductDetail, type ProductDetail } from "../../scripts/studio/detail";

  const FN = 36; // lemon frames, and the unit the idle rotation is expressed in
  const mod = (a: number, b: number) => ((a % b) + b) % b;

  let teardown: (() => void) | null = null;

  function init(): void {
    teardown?.();

    const root = document.querySelector<HTMLElement>("[data-studio]");
    const dataEl = root?.querySelector("[data-studio-data]");
    if (!root || !dataEl) return;

    const q = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;
    const stage = q<HTMLElement>("[data-stage]");
    const ring = q<HTMLElement>("[data-ring]");
    const ghost = q<HTMLElement>("[data-ghost]");
    const nameEl = q<HTMLElement>("[data-name]");
    const subEl = q<HTMLElement>("[data-sub]");
    const hintText = q<HTMLElement>("[data-hint-text]");
    const dotsEl = q<HTMLElement>("[data-dots]");
    const bgsEl = q<HTMLElement>("[data-bgs]");

    // Keyboard users get the carousel; the plain link list is for no-JS visitors and crawlers.
    root.querySelector<HTMLElement>("[data-allnav]")?.setAttribute("hidden", "");

    const RM = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const T = (s: number) => (RM ? 0.01 : s);
    const controller = new AbortController();
    const { signal } = controller;

    /* ---------- renderer and what can be drawn ---------- */
    const all: StudioProduct[] = JSON.parse(dataEl.textContent || "[]");
    let glOK = false;
    const renderer = all.some((p) => p.kind !== null)
      ? createFruitRenderer(() => {
          // Context lost: swap shader canvases for posters (or drop the card) so nothing breaks.
          glOK = false;
          cards.forEach((card, i) => {
            if (data[i].kind === null || data[i].frames) return;
            const poster = data[i].poster;
            if (poster) card.replaceChildren(makePoster(poster));
            else card.hidden = true;
          });
        })
      : null;
    glOK = Boolean(renderer?.ok);

    const data = all.filter((p) => p.frames || (p.kind !== null && glOK) || p.poster);
    const n = data.length;
    if (!n) return;

    function makePoster(src: string): HTMLImageElement {
      const img = new Image();
      img.className = "ps-fruit";
      img.src = src;
      img.alt = "";
      img.width = 400;
      img.height = 480;
      img.decoding = "async";
      return img;
    }

    const bgs = data.map((p) => {
      const d = document.createElement("div");
      d.className = "ps-bg";
      d.style.setProperty("--glow", p.glow);
      d.style.setProperty("--base", p.base);
      bgsEl.appendChild(d);
      return d;
    });

    const canvases: (HTMLCanvasElement | null)[] = [];
    const cards = data.map((p, i) => {
      const c = document.createElement("button");
      c.type = "button";
      c.className = "ps-card";
      c.setAttribute("aria-label", `${p.fullName}, ${i + 1} of ${n}`);
      let canvas: HTMLCanvasElement | null = null;
      if (p.frames) {
        canvas = document.createElement("canvas");
        canvas.width = 400;
        canvas.height = 480;
      } else if (p.kind !== null && glOK) {
        canvas = document.createElement("canvas");
      }
      if (canvas) {
        canvas.className = "ps-fruit";
        canvas.setAttribute("aria-hidden", "true");
        c.appendChild(canvas);
      } else if (p.poster) {
        c.appendChild(makePoster(p.poster));
      }
      canvases.push(canvas);
      c.addEventListener("click", (e) => {
        if (e.detail === 0) activateCard(i); // keyboard activation; pointer clicks are handled on the stage
      }, { signal });
      ring.appendChild(c);
      return c;
    });

    /* ---------- lemon: 36-frame 360 spin ---------- */
    const lemonIdx = data.findIndex((p) => p.frames);
    const lemon = lemonIdx >= 0 ? data[lemonIdx] : null;
    const lemonCanvas = lemonIdx >= 0 ? canvases[lemonIdx] : null;
    const lemonCtx = lemonCanvas ? lemonCanvas.getContext("2d") : null;
    if (lemonCtx) lemonCtx.imageSmoothingQuality = "high";
    const IDLE = lemon?.frames?.idle ?? 10;
    const sp = { f: IDLE };
    const frames: HTMLImageElement[] = [];
    let framesLeft = 0;

    function loadFrame(index: number): void {
      if (!lemon?.frames || frames[index]) return;
      const im = new Image();
      im.decoding = "async";
      im.onload = () => {
        framesLeft--;
        if (index === IDLE || Math.round(sp.f) === index) drawLemon();
      };
      im.src = `${lemon.frames.folder}${String(index).padStart(2, "0")}.webp`;
      frames[index] = im;
    }
    if (lemon?.frames) {
      framesLeft = lemon.frames.count;
      loadFrame(IDLE); // first paint needs one frame; the rest load once the page is idle
      const loadRest = () => {
        for (let k = 0; k < lemon.frames!.count; k++) loadFrame(k);
      };
      if ("requestIdleCallback" in window) requestIdleCallback(loadRest, { timeout: 2500 });
      else setTimeout(loadRest, 1200);
    }
    const nearestFrame = (i: number): HTMLImageElement | null => {
      for (let d = 0; d < FN / 2; d++) {
        for (const k of [i + d, i - d]) {
          const im = frames[mod(k, FN)];
          if (im?.complete && im.naturalWidth) return im;
        }
      }
      return null;
    };
    function drawLemon(): void {
      if (!lemonCtx) return;
      const f = sp.f;
      const i0 = Math.floor(f);
      const t = f - i0;
      const a = nearestFrame(i0);
      const b = frames[mod(i0 + 1, FN)];
      lemonCtx.clearRect(0, 0, 400, 480);
      if (a) lemonCtx.drawImage(a, 0, 0, 400, 480);
      if (t > 0.03 && b?.complete && b.naturalWidth) {
        lemonCtx.globalAlpha = t;
        lemonCtx.drawImage(b, 0, 0, 400, 480);
        lemonCtx.globalAlpha = 1;
      }
    }
    let introDone = false;
    function introSpin(): void {
      if (introDone || RM || !data[active].frames || framesLeft > 0) return;
      introDone = true;
      gsap.to(sp, { f: "+=36", duration: 2.8, ease: "power2.inOut", overwrite: true, onUpdate: drawLemon });
    }

    /* ---------- shader fruits ---------- */
    const spins = data.map((p) => (p.frames ? sp : { f: 0 }));
    let dirty = true;

    function drawFruit(i: number): void {
      const p = data[i];
      const cv = canvases[i];
      if (!renderer || !glOK || p.frames || p.kind === null || !cv) return;
      renderer.draw(p.kind, (spins[i].f * Math.PI * 2) / FN, cv);
    }
    function sizeGL(): void {
      if (!renderer || !glOK) return;
      const { width, height } = renderer.resize(cards[0].offsetWidth || 400, window.devicePixelRatio || 1);
      canvases.forEach((cv, i) => {
        if (cv && !data[i].frames) {
          cv.width = width;
          cv.height = height;
        }
        drawFruit(i);
      });
    }
    const drawActive = () => {
      if (data[active].frames) drawLemon();
      else drawFruit(active);
    };

    /* ---------- state ---------- */
    const st = { pos: Math.min(2, n - 1) };
    let active = st.pos;
    let drag: null | {
      x: number; y: number; p: number; moved: boolean; lp: number; lt: number; v: number;
      spin: boolean; lx: number; sv: number;
    } = null;
    const offset = (i: number) => mod(i - st.pos + n / 2, n) - n / 2;
    const spacing = () => cards[0].offsetWidth * (stage.offsetWidth < 700 ? 0.8 : 0.92);

    function render(): void {
      dirty = true;
      const S = spacing();
      cards.forEach((c, i) => {
        const o = offset(i);
        const a = Math.abs(o);
        const s = Math.max(0.3, 1.1 - a * 0.3);
        const op = a < 1 ? 1 - a * 0.45 : a < 2 ? 0.55 - (a - 1) * 0.33 : Math.max(0, 0.22 - (a - 2) * 0.22);
        const y = Math.pow(a, 1.6) * 20;
        c.style.transform = `translate(-50%,-50%) translate3d(${o * S}px,${y}px,0) rotateY(${-o * 16}deg) rotate(${o * 5}deg) scale(${s})`;
        c.style.opacity = String(op);
        c.style.zIndex = String(Math.round(100 - a * 10));
        c.style.visibility = a > 3 ? "hidden" : "visible";
        c.tabIndex = a < 0.5 ? 0 : -1;
        if (a < 0.5) c.setAttribute("aria-current", "true");
        else c.removeAttribute("aria-current");
      });
    }

    const dots = data.map((p, i) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "ps-dot";
      b.setAttribute("aria-label", `Show ${p.name}`);
      b.addEventListener("click", () => browsing() && goTo(st.pos + offset(i)), { signal });
      dotsEl.appendChild(b);
      return b;
    });

    let firstTheme = true;
    function applyTheme(): void {
      const p = data[active];
      root!.style.setProperty("--accent", p.accent);
      root!.style.setProperty("--on", "#140a00");
      bgs.forEach((b, k) => b.classList.toggle("on", k === active));
      dots.forEach((d, k) => {
        d.classList.toggle("on", k === active);
        if (k === active) d.setAttribute("aria-current", "true");
        else d.removeAttribute("aria-current");
      });
      ghost.textContent = p.name.toUpperCase();
      nameEl.textContent = p.name;
      subEl.textContent = `${p.cat} powder`;
      hintText.textContent = `Drag the ${p.name.toLowerCase()} to turn it. Click it to open the product`;
      if (p.frames) setTimeout(introSpin, 800);
      if (!firstTheme && !RM) {
        gsap.fromTo([nameEl, subEl], { yPercent: 40, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.6, ease: "power3.out", stagger: 0.05, overwrite: true });
        gsap.fromTo(ghost, { opacity: 0, scale: 0.96 }, { opacity: 1, scale: 1, duration: 0.8, ease: "power3.out", overwrite: true });
      }
      firstTheme = false;
    }

    function sync(): void {
      const i = mod(Math.round(st.pos), n);
      if (i !== active) {
        active = i;
        applyTheme();
      }
    }
    function goTo(target: number): void {
      gsap.to(st, { pos: target, duration: T(0.9), ease: "power3.out", overwrite: true, onUpdate() { render(); sync(); } });
    }
    // The carousel is only interactive while no powder effect / detail view is running.
    let detail: ProductDetail | undefined;
    const browsing = () => !detail || detail.mode === "browse";
    const step = (d: number) => {
      if (browsing()) goTo(Math.round(st.pos) + d);
    };

    q<HTMLButtonElement>("[data-prev]").addEventListener("click", () => step(-1), { signal });
    q<HTMLButtonElement>("[data-next]").addEventListener("click", () => step(1), { signal });

    function activateCard(i: number): void {
      if (!browsing() || !detail) return;
      const o = offset(i);
      if (Math.abs(o) < 0.5) detail.open(i);
      else goTo(Math.round(st.pos + o));
    }

    /* ---------- pointer: only horizontal drags are taken over ---------- */
    stage.addEventListener("pointerdown", (e) => {
      if (!browsing() || (e.target as HTMLElement).closest(".ps-ui")) return;
      if (e.pointerType === "mouse" && e.button !== 0) return;
      gsap.killTweensOf(st);
      gsap.killTweensOf(spins[active]);
      const r = cards[active].getBoundingClientRect();
      const spin = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      drag = { x: e.clientX, y: e.clientY, p: st.pos, moved: false, lp: st.pos, lt: performance.now(), v: 0, spin, lx: e.clientX, sv: 0 };
      stage.setPointerCapture(e.pointerId);
    }, { signal });

    stage.addEventListener("pointermove", (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      if (!drag.moved) {
        if (Math.hypot(dx, e.clientY - drag.y) <= 6) return;
        if (Math.abs(dx) <= Math.abs(e.clientY - drag.y)) {
          drag = null; // vertical intent: leave it to the page
          return;
        }
        drag.moved = true;
      }
      if (drag.spin) {
        const now = performance.now();
        const dt = Math.max(1, now - drag.lt);
        const df = (e.clientX - drag.lx) / 11;
        spins[active].f += df;
        drag.sv = 0.8 * drag.sv + 0.2 * ((df / dt) * 1000);
        drag.lx = e.clientX;
        drag.lt = now;
        dirty = true;
        drawActive();
        return;
      }
      st.pos = drag.p - dx / spacing();
      const now = performance.now();
      const dt = now - drag.lt;
      if (dt > 0) {
        drag.v = ((st.pos - drag.lp) / dt) * 1000;
        drag.lp = st.pos;
        drag.lt = now;
      }
      render();
      sync();
    }, { signal });

    const settle = (d: NonNullable<typeof drag>) => {
      if (d.spin) {
        const S = spins[active];
        gsap.to(S, { f: S.f + Math.max(-14, Math.min(14, d.sv * 0.35)), duration: T(1.1), ease: "power3.out", overwrite: true, onUpdate: drawActive });
      } else {
        goTo(Math.round(st.pos + Math.max(-1.5, Math.min(1.5, d.v * 0.18))));
      }
    };
    stage.addEventListener("pointerup", (e) => {
      if (!drag) return;
      const d = drag;
      drag = null;
      if (d.moved) return settle(d);
      const el = document.elementFromPoint(e.clientX, e.clientY);
      const card = el?.closest<HTMLElement>(".ps-card");
      if (card) activateCard(cards.indexOf(card as HTMLButtonElement));
    }, { signal });
    // A cancelled gesture (the browser took over for a vertical scroll) must never activate a card.
    stage.addEventListener("pointercancel", () => {
      if (!drag) return;
      const d = drag;
      drag = null;
      if (d.moved) settle(d);
    }, { signal });

    // Horizontal-dominant wheel/trackpad gestures only; vertical wheel is never touched or prevented.
    let lastWheel = 0;
    stage.addEventListener("wheel", (e) => {
      if (!browsing() || Math.abs(e.deltaX) <= Math.abs(e.deltaY) || Math.abs(e.deltaX) <= 20) return;
      const now = performance.now();
      if (now - lastWheel < 500) return;
      lastWheel = now;
      step(e.deltaX > 0 ? 1 : -1);
    }, { passive: true, signal });

    let visible = true;
    window.addEventListener("keydown", (e) => {
      if (!browsing() || e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      const t = e.target as HTMLElement;
      if (t.closest("input, textarea, select, [contenteditable], dialog, [role='dialog']")) return;
      if (!(root.contains(t) || (t === document.body && visible))) return;
      step(e.key === "ArrowRight" ? 1 : -1);
    }, { signal });

    /* ---------- render loop: only while the studio is on screen and the tab is visible ---------- */
    let raf = 0;
    let lastTime = 0;
    let frame = 0;
    function loop(now: number): void {
      raf = requestAnimationFrame(loop);
      const dt = Math.min(0.05, (now - lastTime) / 1000);
      lastTime = now;
      frame++;
      if (!glOK || detail?.mode === "detail") return;
      if (!RM && !drag && browsing() && !data[active].frames && !gsap.isTweening(spins[active])) {
        spins[active].f += dt * 0.9;
        dirty = true;
      }
      if (RM && !dirty) return;
      for (let i = 0; i < n; i++) {
        if (data[i].frames || Math.abs(offset(i)) > 2.6) continue;
        if (i === active || (frame + i) % 4 === 0) drawFruit(i);
      }
      if (RM) dirty = false;
    }
    const running = () => visible && !document.hidden;
    function syncLoop(): void {
      if (running() && !raf) {
        lastTime = performance.now();
        raf = requestAnimationFrame(loop);
      } else if (!running() && raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    }
    const io = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      syncLoop();
    });
    io.observe(root);
    document.addEventListener("visibilitychange", syncLoop, { signal });

    const ro = new ResizeObserver(() => {
      sizeGL();
      render();
    });
    ro.observe(stage);

    /* ---------- start ---------- */
    applyTheme();
    sizeGL();
    render();
    detail = createProductDetail({
      root,
      stage,
      data,
      cards,
      hud: Array.from(root.querySelectorAll<HTMLElement>(".ps-arrow, .ps-dots, .ps-hint, .ps-cue, .ps-cta")),
      nameEl,
      subEl,
      renderer,
      glOK: () => glOK,
      reducedMotion: RM,
      fruit: (i) => cards[i].querySelector<HTMLElement>(".ps-fruit"),
      freeze: (i) => {
        const S = spins[i];
        gsap.killTweensOf(S);
        S.f = Math.round(S.f);
        drawActive();
      },
      restore: () => {
        render();
        applyTheme();
        drawActive();
      },
      select: (j) => {
        active = j;
        st.pos = j + n * Math.round((st.pos - j) / n);
        render();
        applyTheme();
      },
      active: () => active,
    });
    syncLoop();

    teardown = () => {
      detail?.destroy();
      controller.abort();
      cancelAnimationFrame(raf);
      io.disconnect();
      ro.disconnect();
      gsap.killTweensOf([st, sp, nameEl, subEl, ghost, ...spins]);
      renderer?.dispose();
      ring.replaceChildren();
      bgsEl.replaceChildren();
      dotsEl.replaceChildren();
      teardown = null;
    };
  }

  onPageLoad(init);
  window.addEventListener("pagehide", () => teardown?.());
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) init();
  });
</script>
