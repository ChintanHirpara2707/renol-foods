---
// Shared fruit artwork & vector symbols for all 8 Renol products
---

<svg width="0" height="0" class="absolute pointer-events-none" aria-hidden="true" focusable="false">
  <defs id="fruit-svg-defs">
    <linearGradient id="g-mango" x1=".2" y1="0" x2=".8" y2="1">
      <stop offset="0" stop-color="#ffe066" />
      <stop offset=".45" stop-color="#ffa41b" />
      <stop offset="1" stop-color="#ee4b2b" />
    </linearGradient>
    <radialGradient id="g-tomato" cx=".38" cy=".32" r=".8">
      <stop offset="0" stop-color="#ff7a63" />
      <stop offset=".55" stop-color="#e11d2a" />
      <stop offset="1" stop-color="#8f0d1b" />
    </radialGradient>
    <radialGradient id="g-lemon" cx=".38" cy=".3" r=".85">
      <stop offset="0" stop-color="#fff7a1" />
      <stop offset=".5" stop-color="#ffd90f" />
      <stop offset="1" stop-color="#d9a600" />
    </radialGradient>
    <linearGradient id="g-leaf" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6ee08a" />
      <stop offset="1" stop-color="#1c7a3a" />
    </linearGradient>
    <linearGradient id="g-ginger" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#efd0a0" />
      <stop offset=".55" stop-color="#c99b5e" />
      <stop offset="1" stop-color="#9a6d34" />
    </linearGradient>
    <linearGradient id="g-caramel" x1=".2" y1="0" x2=".8" y2="1">
      <stop offset="0" stop-color="#fed7aa" />
      <stop offset=".45" stop-color="#ea580c" />
      <stop offset="1" stop-color="#7c2d12" />
    </linearGradient>
    <radialGradient id="g-apple" cx=".4" cy=".35" r=".8">
      <stop offset="0" stop-color="#ff7675" />
      <stop offset=".55" stop-color="#d63031" />
      <stop offset="1" stop-color="#74121d" />
    </radialGradient>
    <g id="leaf">
      <path d="M100 220 C58 196 50 120 100 30 C150 120 142 196 100 220Z" fill="url(#g-leaf)" />
      <path d="M100 216 L100 50" stroke="#c8f7d0" stroke-opacity=".55" stroke-width="3" stroke-linecap="round" fill="none" />
      <path d="M100 172 L74 148 M100 142 L126 114 M100 122 L76 100 M100 92 L120 74" stroke="#c8f7d0" stroke-opacity=".4" stroke-width="2" stroke-linecap="round" fill="none" />
    </g>
  </defs>

  <!-- Tomato Symbol -->
  <symbol id="f-tomato" viewBox="0 0 200 240">
    <path d="M100 56 C150 40 192 74 190 130 C188 188 148 226 100 226 C52 226 12 188 10 130 C8 74 50 40 100 56Z" fill="url(#g-tomato)" />
    <ellipse cx="58" cy="108" rx="16" ry="30" fill="#fff" fill-opacity=".26" transform="rotate(24 58 108)" />
    <path d="M100 52 L100 30" stroke="#3b7d2a" stroke-width="8" stroke-linecap="round" />
    <path d="M100 50 L113 66 L134 58 L126 78 L148 84 L127 95 L100 88 L73 95 L52 84 L74 78 L66 58 L87 66Z" fill="#2f9e44" />
  </symbol>

  <!-- Lemon Symbol (Poster / Fallback) -->
  <symbol id="f-lemon" viewBox="0 0 200 240">
    <image id="lemonSym" href="/frames/lemon/10.webp" x="0" y="0" width="200" height="240" preserveAspectRatio="xMidYMid meet" />
  </symbol>

  <!-- Mango Symbol -->
  <symbol id="f-mango" viewBox="0 0 200 240">
    <path d="M104 40 C158 34 190 90 184 146 C178 202 138 232 92 224 C44 216 14 174 22 120 C28 72 58 44 104 40Z" fill="url(#g-mango)" />
    <path d="M150 64 C176 92 180 150 150 196" fill="none" stroke="#ee4b2b" stroke-opacity=".35" stroke-width="16" stroke-linecap="round" />
    <ellipse cx="62" cy="104" rx="12" ry="32" fill="#fff" fill-opacity=".28" transform="rotate(14 62 104)" />
    <path d="M104 42 C102 30 107 22 114 16" fill="none" stroke="#5a3a12" stroke-width="5" stroke-linecap="round" />
    <path d="M114 20 C138 6 166 12 178 28 C152 34 128 32 114 20Z" fill="url(#g-leaf)" />
    <path d="M116 21 C136 20 156 24 170 28" fill="none" stroke="#c8f7d0" stroke-opacity=".6" stroke-width="1.5" />
  </symbol>

  <!-- Spinach Symbol -->
  <symbol id="f-spinach" viewBox="0 0 200 240">
    <path d="M100 216 L100 236" stroke="#8bd69a" stroke-width="7" stroke-linecap="round" />
    <g opacity=".92">
      <use href="#leaf" transform="translate(100 222) rotate(-34) scale(.86) translate(-100 -222)" />
    </g>
    <g opacity=".92">
      <use href="#leaf" transform="translate(100 222) rotate(34) scale(.86) translate(-100 -222)" />
    </g>
    <use href="#leaf" />
  </symbol>

  <!-- Ginger Symbol -->
  <symbol id="f-ginger" viewBox="0 0 200 240">
    <path d="M40 160 C18 130 36 104 64 108 C66 76 98 64 116 84 C126 52 164 56 166 90 C196 92 198 130 178 146 C192 168 170 198 146 190 C140 214 100 216 90 196 C66 208 36 192 40 160Z" fill="url(#g-ginger)" />
    <ellipse cx="146" cy="62" rx="15" ry="8" fill="#f3e3a8" />
    <path d="M62 122 C74 128 84 128 94 122 M104 152 C118 160 132 160 146 152 M60 170 C72 178 84 178 96 172" stroke="#7a5424" stroke-opacity=".4" stroke-width="3" fill="none" stroke-linecap="round" />
    <ellipse cx="78" cy="138" rx="14" ry="22" fill="#fff" fill-opacity=".18" transform="rotate(20 78 138)" />
  </symbol>

  <!-- Tamarind Symbol -->
  <symbol id="f-tamarind" viewBox="0 0 200 240">
    <g fill="none" stroke-linecap="round">
      <path d="M44 56 L30 46" stroke="#5a3a1a" stroke-width="6" />
      <path d="M44 56 C118 36 176 108 142 196" stroke="#4a2a10" stroke-width="46" />
      <path d="M44 56 C118 36 176 108 142 196" stroke="#a8683a" stroke-width="40" />
      <path d="M44 56 C118 36 176 108 142 196" stroke="#4a2a10" stroke-opacity=".5" stroke-width="40" stroke-linecap="butt" stroke-dasharray="2 30" />
      <path d="M38 48 C112 26 168 98 134 188" stroke="#d6a06a" stroke-opacity=".55" stroke-width="7" />
    </g>
  </symbol>

  <!-- Caramel Symbol -->
  <symbol id="f-caramel" viewBox="0 0 200 240">
    <path d="M52 108 C50 72 82 48 116 48 C154 48 174 76 170 118 C166 160 146 200 102 204 C56 208 54 152 52 108Z" fill="url(#g-caramel)" />
    <path d="M72 102 C78 74 128 68 148 98 C162 122 132 156 98 152 C72 148 68 122 72 102Z" fill="#b45309" fill-opacity=".6" />
    <ellipse cx="92" cy="78" rx="20" ry="10" fill="#fff" fill-opacity=".32" transform="rotate(-18 92 78)" />
    <path d="M122 122 C140 132 154 118 156 104" fill="none" stroke="#fef08a" stroke-width="4" stroke-linecap="round" stroke-opacity=".7" />
    <circle cx="140" cy="180" r="14" fill="url(#g-caramel)" />
    <circle cx="65" cy="170" r="10" fill="url(#g-caramel)" />
  </symbol>

  <!-- Apple Symbol -->
  <symbol id="f-apple" viewBox="0 0 200 240">
    <path d="M100 68 C80 50 35 60 25 110 C15 160 55 220 95 220 C100 220 103 216 108 216 C113 216 116 220 121 220 C161 220 185 160 175 110 C165 60 120 50 100 68Z" fill="url(#g-apple)" />
    <ellipse cx="60" cy="115" rx="14" ry="32" fill="#fff" fill-opacity=".25" transform="rotate(22 60 115)" />
    <path d="M100 68 C102 46 114 30 126 22" fill="none" stroke="#5a3a12" stroke-width="6" stroke-linecap="round" />
    <path d="M108 45 C125 32 152 36 160 50 C140 56 120 54 108 45Z" fill="url(#g-leaf)" />
    <path d="M110 46 C126 44 144 48 154 51" fill="none" stroke="#c8f7d0" stroke-width="1.5" stroke-opacity=".7" />
  </symbol>
</svg>
