---
import { licences } from "../data/licences";
import { isPublic } from "../data/public";

interface Props {
  align?: "start" | "center";
}
const { align = "start" } = Astro.props;
---

<ul class:list={["licences", `licences--${align}`]} aria-label="Licences and certifications">
  {
    licences.map((l) => (
      <li class="licences__badge">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>{l.label}</span>
        {isPublic(l.number) && <span class="licences__number">No. {l.number}</span>}
      </li>
    ))
  }
</ul>

<style>
  .licences {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .licences--center {
    justify-content: center;
  }
  .licences__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink);
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: 1.3;
  }
  .licences__badge svg {
    flex: none;
    color: var(--accent);
  }
  .licences__number {
    color: var(--ink-2);
    font-weight: 500;
  }
</style>
