---
import { site } from "../data/site";

const waUrl = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`;
---

<aside class="wa-wrap" aria-label="WhatsApp">
<a class="wa" href={waUrl} target="_blank" rel="noopener noreferrer" aria-label="Chat with Renol Foods on WhatsApp">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M.057 24l1.687-6.163A11.9 11.9 0 0 1 .157 11.89C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.82 11.82 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24Zm6.597-3.807A9.87 9.87 0 0 0 12.046 21.8c5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884 0 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981Z" />
  </svg>
</a>
</aside>

<style>
  /* Desktop only; the mobile bottom bar carries WhatsApp below 768px. */
  .wa-wrap {
    display: none;
  }
  @media (min-width: 768px) {
    .wa-wrap {
      display: block;
    }
    .wa {
      position: fixed;
      inset-block-end: var(--s-6);
      inset-inline-end: var(--s-6);
      z-index: var(--z-bar);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      inline-size: 3.5rem;
      block-size: 3.5rem;
      border-radius: 50%;
      background: #128c4a;
      color: #fff;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
      transition: transform var(--dur-1) var(--ease-out), filter var(--dur-1) var(--ease-out);
    }
    .wa:hover {
      transform: translateY(-2px);
      filter: brightness(1.1);
    }
  }
</style>
