---
import { siteConfig } from "../../data/site";
---

<div class="relative z-10 py-16 sm:py-24 lg:py-36">
  <div class="section-container">
    <div class="max-w-2xl lg:max-w-2xl">
      
      <!-- Eyebrow Pill -->
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-cream-200/90 border border-green-black/10 text-xs font-semibold tracking-widest uppercase text-forest-700 backdrop-blur-sm mb-6 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-tomato animate-pulse"></span>
        <span>B2B Food Powders &bull; Bavla, Gujarat</span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-green-black leading-[1.12]">
        Precision Food Powders Engineered for <span class="italic font-normal text-forest-800">Global Manufacturers</span>
      </h1>

      <!-- Supporting Subline -->
      <p class="mt-6 text-base sm:text-lg lg:text-xl text-forest-700 leading-relaxed font-sans max-w-xl">
        Dehydrated and spray-dried fruit, vegetable, and culinary powders produced in Bavla for food manufacturing, baking, snack, and beverage applications.
      </p>

      <!-- Lead Generation Call-to-Actions -->
      <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <a
          href="/contact#sample-quote"
          class="btn-accent text-center text-sm sm:text-base !py-3.5 !px-8 shadow-md hover:shadow-lg"
        >
          <span>Request a Sample</span>
          <svg class="w-4 h-4 ml-1 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a
          href="#products-section"
          class="btn-secondary text-center text-sm sm:text-base !py-3.5 !px-7 bg-cream-100/80 backdrop-blur-sm"
        >
          View Products
        </a>
      </div>

      <!-- Real Facts Stats Bar -->
      <div class="mt-12 pt-8 border-t border-green-black/10 grid grid-cols-3 gap-4 text-left">
        <div>
          <p class="font-serif text-2xl sm:text-3xl font-bold text-green-black">8</p>
          <p class="text-xs font-semibold uppercase tracking-wider text-forest-600 mt-0.5">Core Powders</p>
          <p class="text-[11px] text-forest-500 hidden sm:block">Fruit, Veg & Spices</p>
        </div>

        <div>
          <p class="font-serif text-2xl sm:text-3xl font-bold text-green-black">B2B</p>
          <p class="text-xs font-semibold uppercase tracking-wider text-forest-600 mt-0.5">Supply Focus</p>
          <p class="text-[11px] text-forest-500 hidden sm:block">Bulk & custom orders</p>
        </div>

        <div>
          <p class="font-serif text-2xl sm:text-3xl font-bold text-green-black">2021</p>
          <p class="text-xs font-semibold uppercase tracking-wider text-forest-600 mt-0.5">Established</p>
          <p class="text-[11px] text-forest-500 hidden sm:block">Bavla, Ahmedabad</p>
        </div>
      </div>

    </div>
  </div>
</div>
