---
// CookieNotice.astro - Responsive, accessible dark-themed cookie consent banner
---

<div
  id="cookie-notice"
  class="fixed bottom-0 left-0 right-0 z-50 p-4 sm:p-6 transition-all duration-500 transform translate-y-full opacity-0 pointer-events-none mb-[calc(60px+env(safe-area-inset-bottom,0px))] md:mb-0"
  role="region"
  aria-label="Cookie consent banner"
>
  <div class="max-w-4xl mx-auto rounded-2xl bg-[#121214]/95 border border-white/15 p-5 sm:p-6 backdrop-blur-xl shadow-2xl text-white">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-5">
      <div class="space-y-1.5 max-w-2xl">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          <h3 class="font-display text-base sm:text-lg font-bold tracking-tight text-white">
            Cookie & Privacy Notice
          </h3>
        </div>
        <p class="text-xs sm:text-sm text-white/70 leading-relaxed font-body">
          We use essential technical cookies to guarantee correct site navigation and evaluate B2B inquiry submissions. By continuing, you agree to our standard data handling under our <a href="/cookies" class="text-amber-400 underline hover:text-amber-300">Cookie Policy</a> and <a href="/privacy" class="text-amber-400 underline hover:text-amber-300">Privacy Policy</a>.
        </p>
      </div>

      <div class="flex items-center flex-wrap sm:flex-nowrap gap-2.5 w-full md:w-auto shrink-0">
        <button
          type="button"
          id="cookie-accept-all"
          class="btn-accent flex-1 sm:flex-initial !py-2.5 !px-5 text-xs sm:text-sm min-h-[44px] min-w-[44px]"
        >
          Accept All
        </button>
        <button
          type="button"
          id="cookie-essential"
          class="btn-secondary flex-1 sm:flex-initial !py-2.5 !px-4 text-xs sm:text-sm min-h-[44px] min-w-[44px]"
        >
          Essential Only
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function initCookieNotice() {
    const banner = document.getElementById("cookie-notice");
    const acceptBtn = document.getElementById("cookie-accept-all");
    const essentialBtn = document.getElementById("cookie-essential");

    if (!banner || !acceptBtn || !essentialBtn) return;

    const consent = localStorage.getItem("renol_cookie_consent");

    if (!consent) {
      setTimeout(() => {
        banner.classList.remove("translate-y-full", "opacity-0", "pointer-events-none");
        banner.classList.add("translate-y-0", "opacity-100", "pointer-events-auto");
      }, 900);
    }

    const dismissNotice = (val: string) => {
      localStorage.setItem("renol_cookie_consent", val);
      banner.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");
      banner.classList.add("translate-y-full", "opacity-0", "pointer-events-none");
    };

    acceptBtn.addEventListener("click", () => dismissNotice("all"));
    essentialBtn.addEventListener("click", () => dismissNotice("essential"));
  }

  // Run on load and astro view transitions if present
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCookieNotice);
  } else {
    initCookieNotice();
  }
</script>
