---
import { nav } from "../data/nav";

const cookiesHref = nav.legal.find((l) => l.label === "Cookies")?.href ?? "/cookies";
---

<aside class="notice" id="cookie-notice" role="region" aria-label="Cookie notice" hidden>
  <div class="notice__text">
    <p>
      This site uses no analytics or advertising cookies. It only remembers, in your browser, that you have seen this
      notice.
    </p>
    <a href={cookiesHref}>Read the cookie notice</a>
  </div>
  <button type="button" class="notice__btn" data-notice-dismiss>Got it</button>
</aside>

<style>
  .notice {
    position: fixed;
    z-index: var(--z-notice);
    inset-inline: var(--s-3) calc(var(--stack-size) + var(--stack-offset) + var(--s-3));
    inset-block-end: calc(var(--s-3) + env(safe-area-inset-bottom, 0px));
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: rgba(18, 18, 20, 0.97);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
    font-size: var(--fs-small);
    color: var(--ink-2);
    animation: notice-in var(--dur-2) var(--ease-out);
  }
  .notice[hidden] {
    display: none;
  }
  .notice a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .notice__btn {
    flex: none;
    min-height: var(--tap);
    padding: 0 var(--s-6);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.1);
    color: var(--ink);
    font-weight: 600;
    cursor: pointer;
  }
  .notice__btn:hover {
    background: rgba(255, 255, 255, 0.18);
  }
  @media (min-width: 768px) {
    .notice {
      inset-inline: var(--s-6) auto;
      inset-block-end: var(--s-6);
      max-inline-size: 30rem;
    }
  }
  @keyframes notice-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
</style>

<script>
  import { onPageLoad } from "../scripts/lifecycle";

  const KEY = "renol_notice_seen";

  function read(): boolean {
    try {
      return localStorage.getItem(KEY) === "1";
    } catch {
      return false;
    }
  }

  function write(): void {
    try {
      localStorage.setItem(KEY, "1");
    } catch {
      /* private mode: the notice simply shows again next visit */
    }
  }

  onPageLoad(() => {
    const el = document.getElementById("cookie-notice");
    const btn = el?.querySelector<HTMLButtonElement>("[data-notice-dismiss]");
    if (!el || !btn || read()) return;
    el.hidden = false;
    btn.addEventListener("click", () => {
      write();
      el.hidden = true;
    });
  });
</script>
