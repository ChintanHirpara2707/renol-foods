---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"a">, "type"> {
  href?: string;
  variant?: "primary" | "ghost" | "link";
  size?: "md" | "lg";
  type?: "button" | "submit" | "reset";
  class?: string;
}

const { href, variant = "primary", size = "md", type = "button", class: className, ...rest } = Astro.props;
const Tag = href ? "a" : "button";
const attrs = href ? { href } : { type };
---

<Tag class:list={["btn", `btn--${variant}`, `btn--${size}`, className]} {...attrs} {...rest}>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    min-height: var(--tap);
    padding: 0 var(--s-6);
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    font-family: var(--body);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      filter var(--dur-1) var(--ease-out),
      transform var(--dur-1) var(--ease-out);
  }
  .btn--lg {
    min-height: 3.25rem;
    padding: 0 var(--s-8);
    font-size: 1rem;
  }
  .btn--primary {
    background: var(--accent);
    color: var(--on-accent);
  }
  .btn--primary:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }
  .btn--ghost {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--line);
    color: var(--ink);
  }
  .btn--ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.34);
  }
  .btn--link {
    padding: 0 var(--s-2);
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--line);
  }
  .btn--link:hover {
    text-decoration-color: var(--accent);
  }
  .btn:active {
    transform: translateY(0);
  }
</style>
