---
interface Props {
  accent?: string;
}
const { accent } = Astro.props;
---

<span class="tag">
  {accent && <span class="tag__dot" style={`background:${accent}`} aria-hidden="true" />}
  <slot />
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink-2);
    font-size: var(--fs-small);
    line-height: 1.4;
  }
  .tag__dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
  }
</style>
