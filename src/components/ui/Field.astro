---
interface Props {
  label: string;
  name: string;
  type?: "text" | "email" | "tel" | "select" | "textarea";
  required?: boolean;
  hint?: string;
  error?: string;
  options?: string[];
  autocomplete?: string;
  rows?: number;
  placeholder?: string;
}

const {
  label,
  name,
  type = "text",
  required = false,
  hint,
  error,
  options = [],
  autocomplete,
  rows = 4,
  placeholder,
} = Astro.props;

const id = `field-${name}`;
const describedBy = [hint ? `${id}-hint` : "", error ? `${id}-error` : ""].filter(Boolean).join(" ") || undefined;
const common = {
  id,
  name,
  required,
  autocomplete,
  placeholder,
  "aria-describedby": describedBy,
  "aria-invalid": error ? "true" : undefined,
};
---

<div class="field">
  <label for={id}>
    {label}
    {required && <span class="field__req" aria-hidden="true"> *</span>}
  </label>
  {
    type === "textarea" ? (
      <textarea rows={rows} {...(common as any)} />
    ) : type === "select" ? (
      <select {...(common as any)}>
        <option value="">Select</option>
        {options.map((o) => (
          <option value={o}>{o}</option>
        ))}
      </select>
    ) : (
      <input type={type} {...(common as any)} />
    )
  }
  {hint && <p id={`${id}-hint`} class="field__hint">{hint}</p>}
  {error && <p id={`${id}-error`} class="field__error" role="alert">{error}</p>}
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  label {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink);
  }
  .field__req {
    color: var(--accent);
  }
  input,
  select,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
  }
  textarea {
    resize: vertical;
  }
  ::placeholder {
    color: var(--ink-3);
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline-offset: 1px;
    border-color: var(--accent);
  }
  [aria-invalid="true"] {
    border-color: #ff8a80;
  }
  .field__hint {
    color: var(--ink-3);
    font-size: var(--fs-small);
  }
  .field__error {
    color: #ff9e95;
    font-size: var(--fs-small);
  }
</style>
