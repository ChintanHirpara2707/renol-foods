---
import { site, whatsappLink, callLink } from "../data/site";
import { CTA } from "../data/cta";

interface Props {
  /** WhatsApp text. Product pages pass one that names the product and packaging. */
  message?: string;
}

const { message } = Astro.props;
const items = [
  { key: "whatsapp", href: whatsappLink(message), label: CTA.chat.label, external: true },
  { key: "map", href: site.mapUrl, label: "Open location in Google Maps", tip: "Map", external: true },
  { key: "call", href: callLink, label: `Call ${site.phones[0].display}`, tip: "Call", external: false },
];
---

<nav class="contact-stack" aria-label="Contact Renol Foods">
  {
    items.map((item) => (
      <a
        class={`contact-stack__btn contact-stack__btn--${item.key}`}
        href={item.href}
        aria-label={item.label}
        target={item.external ? "_blank" : undefined}
        rel={item.external ? "noopener noreferrer" : undefined}
      >
        {item.key === "whatsapp" && (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
          </svg>
        )}
        {item.key === "map" && (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            <circle cx="12" cy="9.5" r="2.5" stroke="currentColor" stroke-width="1.8" />
          </svg>
        )}
        {item.key === "call" && (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
          </svg>
        )}
        <span class="contact-stack__tip" aria-hidden="true">{item.tip ?? "WhatsApp"}</span>
      </a>
    ))
  }
</nav>

<style>
  .contact-stack {
    position: fixed;
    z-index: var(--z-stack);
    inset-inline-end: calc(var(--stack-offset) + env(safe-area-inset-right, 0px));
    inset-block-end: calc(var(--stack-offset) + env(safe-area-inset-bottom, 0px));
    display: flex;
    flex-direction: column;
    gap: var(--stack-gap);
  }
  .contact-stack__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--stack-size);
    block-size: var(--stack-size);
    border-radius: 50%;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.45);
    transition: transform var(--dur-1) var(--ease-out), filter var(--dur-1) var(--ease-out);
  }
  .contact-stack__btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.12);
  }
  .contact-stack__btn--whatsapp {
    background: #0f7a40;
    color: #fff;
  }
  .contact-stack__btn--map {
    background: #2456d4;
    color: #fff;
  }
  .contact-stack__btn--call {
    background: var(--accent);
    color: var(--on-accent);
  }

  /* Tooltip: desktop pointers only */
  .contact-stack__tip {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .contact-stack__tip {
      position: absolute;
      inset-inline-end: calc(100% + 0.625rem);
      display: block;
      padding: 0.375rem 0.75rem;
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      background: var(--panel);
      color: var(--ink);
      font-size: var(--fs-small);
      font-weight: 600;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transform: translateX(0.25rem);
      transition: opacity var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-out);
    }
    .contact-stack__btn:hover .contact-stack__tip,
    .contact-stack__btn:focus-visible .contact-stack__tip {
      opacity: 1;
      transform: none;
    }
  }
</style>
