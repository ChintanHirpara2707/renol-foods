---
import { siteConfig } from "../data/site";

// Clean address for public display without internal verification tags
const displayAddress = siteConfig.location.fullAddress
  .replace(/\[.*?\]/g, "")
  .trim();

// Check if email is verified (does not contain confirmation placeholder)
const isEmailConfirmed = !siteConfig.contact.email.includes("[CONFIRM");
---

<footer
  class="bg-[#0e0e12] text-white pt-16 pb-28 md:pb-16 border-t border-white/10 font-body"
>
  <div class="section-container">
    <!-- Main Footer Grid: 4 cols on desktop, 2 on tablet, 1 on mobile -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 pb-12 border-b border-white/10"
    >
      <!-- Column 1: Brand & Facility Information (4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        <a
          href="/"
          class="flex items-center group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/50 rounded-lg p-1"
        >
          <img
            src="/images/Logo.png"
            alt={`${siteConfig.name} home`}
            width="250"
            height="70"
            decoding="async"
            fetchpriority="high"
            class="h-13 w-auto max-w-[250px] object-contain transition-transform duration-300 group-hover:scale-105"
          />
        </a>
        <p class="text-white/70 text-sm leading-relaxed max-w-sm">
          Precision dehydrated and spray-dried fruit, vegetable, and culinary
          powders manufactured in Bavla, Ahmedabad. Supplying global food
          industry formulators and exporters.
        </p>
        <div class="pt-2 text-xs text-white/40 space-y-1">
          <p>Founded: {siteConfig.foundedYear} &bull; Bavla, Gujarat, India</p>
          <p class="text-white/70 font-medium">
            B2B Manufacturing &bull; Bulk & Custom Supply
          </p>
        </div>
      </div>

      <!-- Column 2: Core Powders (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="font-display text-base font-bold text-white tracking-wide">
          Product Portfolio
        </h4>
        <ul class="space-y-2 text-sm text-white/70">
          {
            siteConfig.products.map((product) => (
              <li>
                <a
                  href={`/products/${product.slug}`}
                  class="hover:text-white transition-colors duration-150 inline-flex items-center gap-2.5 py-1 min-h-[32px] group"
                >
                  <span
                    class="w-2 h-2 rounded-full shrink-0 group-hover:scale-125 transition-transform"
                    style={{ backgroundColor: product.color }}
                  />
                  <span>{product.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 3: Capabilities & Links (2 cols) -->
      <div class="lg:col-span-2 space-y-3">
        <h4 class="font-display text-base font-bold text-white tracking-wide">
          Capabilities
        </h4>
        <ul class="space-y-2 text-sm text-white/70">
          <li>
            <a
              href="/manufacturing"
              class="hover:text-white transition-colors inline-block py-1"
            >
              Manufacturing
            </a>
          </li>
          <li>
            <a
              href="/quality"
              class="hover:text-white transition-colors inline-block py-1"
            >
              Quality & Testing
            </a>
          </li>
          <li>
            <a
              href="/industries"
              class="hover:text-white transition-colors inline-block py-1"
            >
              Industries Served
            </a>
          </li>
          <li>
            <a
              href="/private-label"
              class="hover:text-white transition-colors inline-block py-1"
            >
              Private Label
            </a>
          </li>
          <li>
            <a
              href="/export"
              class="hover:text-white transition-colors inline-block py-1"
            >
              Global Export
            </a>
          </li>
          <li>
            <a
              href="/downloads"
              class="hover:text-white transition-colors inline-block py-1"
            >
              Downloads & Specs
            </a>
          </li>
          <li>
            <a
              href="/faq"
              class="hover:text-white transition-colors inline-block py-1"
            >
              Frequently Asked FAQs
            </a>
          </li>
          <li>
            <a
              href="/request-quote"
              class="text-amber-400 font-semibold hover:text-amber-300 inline-block py-1"
            >
              Request a Sample &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Factory & Direct Sales Contact (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="font-display text-base font-bold text-white tracking-wide">
          Sales & Inquiries
        </h4>

        <div class="space-y-3 text-sm text-white/70">
          <div>
            <p class="text-xs uppercase tracking-wider text-white/40">
              Direct Phone Lines
            </p>
            <div class="mt-1.5 space-y-1">
              {
                siteConfig.contact.displayPhones.map((phone, idx) => (
                  <p>
                    <a
                      href={`tel:${siteConfig.contact.phones[idx]}`}
                      class="hover:text-white font-medium inline-block py-1 min-h-[32px]"
                    >
                      {phone}
                    </a>
                  </p>
                ))
              }
            </div>
          </div>

          {
            isEmailConfirmed && (
              <div class="pt-1">
                <p class="text-xs uppercase tracking-wider text-white/40">
                  Corporate Email
                </p>
                <p class="font-mono text-xs text-white/80 break-words mt-0.5">
                  {siteConfig.contact.email}
                </p>
              </div>
            )
          }

          <div class="pt-1">
            <p class="text-xs uppercase tracking-wider text-white/40">
              Manufacturing Facility
            </p>
            <p class="text-xs leading-relaxed text-white/60 mt-0.5">
              {displayAddress}
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Legal & Compliance Bar -->
    <div
      class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-white/50"
    >
      <div class="text-center md:text-left">
        <p>
          &copy; {new Date().getFullYear()}
          {siteConfig.name}. All rights reserved.
        </p>
        <p class="mt-0.5 text-white/40">
          Pure B2B Food Ingredient Manufacturing &bull; Bavla, Ahmedabad,
          Gujarat.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-6">
        <a
          href="/about"
          class="hover:text-white transition-colors py-1 min-h-[32px] inline-flex items-center"
          >About</a
        >
        <a
          href="/terms"
          class="hover:text-white transition-colors py-1 min-h-[32px] inline-flex items-center"
          >Terms of Supply</a
        >
        <a
          href="/privacy"
          class="hover:text-white transition-colors py-1 min-h-[32px] inline-flex items-center"
          >Privacy Policy</a
        >
        <a
          href="/cookies"
          class="hover:text-white transition-colors py-1 min-h-[32px] inline-flex items-center"
          >Cookie Policy</a
        >
      </div>
    </div>
  </div>
</footer>
