---
import Logo from "./ui/Logo.astro";
import LicenceBadges from "./LicenceBadges.astro";
import { nav } from "../data/nav";
import { site, DEMO, whatsappLink, callLink } from "../data/site";
import { categories } from "../data/categories";
import { isPublic } from "../data/public";

const year = new Date().getFullYear();
const companyLinks = [...nav.primary.filter((l) => l.href !== "/products"), ...nav.secondary];
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href="/" aria-label="Renol Foods, home"><Logo /></a>
      <p>{site.description}</p>
      <p class="site-footer__founded">Founded {site.foundedYear}</p>
      <div class="site-footer__licences"><LicenceBadges /></div>
    </div>

    <nav aria-labelledby="footer-products">
      <h2 id="footer-products">Products</h2>
      <ul>
        {
          categories.map((c) => (
            <li>
              <a href={`/products#${c.hash}`}>{c.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-company">
      <h2 id="footer-company">Company</h2>
      <ul>
        {
          companyLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2>Contact</h2>
      <ul>
        <li>
          <a href={DEMO.href}>{DEMO.label}</a>
        </li>
        {
          site.phones.map((p) => (
            <li>
              <a href={`tel:${p.tel}`}>{p.display}</a>
            </li>
          ))
        }
        {
          isPublic(site.email) && (
            <li>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </li>
          )
        }
        <li>
          <a href={site.mapUrl} target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
        </li>
      </ul>
      <address>
        {site.address.street}<br />
        {site.address.city}, {site.address.state}<br />
        {site.address.country}
      </address>
    </div>
  </div>

  <div class="container site-footer__panel-container">
    <div class="site-footer__panel">
      <div class="site-footer__panel-intro">
        <h2 class="site-footer__panel-title">Talk to Renol Foods</h2>
        <p class="site-footer__panel-desc">Message us on WhatsApp, call us, or find the plant on the map.</p>
      </div>

      <div class="site-footer__panel-buttons">
        <a
          href={whatsappLink()}
          target="_blank"
          rel="noopener noreferrer"
          class="site-footer__panel-btn site-footer__panel-btn--whatsapp"
          aria-label="Chat with Renol Foods on WhatsApp (opens in a new tab)"
        >
          <span class="site-footer__panel-badge site-footer__panel-badge--whatsapp" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
            </svg>
          </span>
          <span class="site-footer__btn-text">
            <span class="site-footer__btn-title">Chat on WhatsApp</span>
            <span class="site-footer__btn-sub site-footer__btn-sub--whatsapp">{site.whatsappNumber}</span>
          </span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="site-footer__btn-arrow">
            <path d="M7 17L17 7M17 7H7M17 7V17" />
          </svg>
        </a>

        <a
          href={site.mapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="site-footer__panel-btn site-footer__panel-btn--map"
          aria-label="Open Renol Foods location in Google Maps (opens in a new tab)"
        >
          <span class="site-footer__panel-badge site-footer__panel-badge--map" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
              <circle cx="12" cy="9.5" r="2.5" stroke="currentColor" stroke-width="1.8" />
            </svg>
          </span>
          <span class="site-footer__btn-text">
            <span class="site-footer__btn-title">Open in Google Maps</span>
            <span class="site-footer__btn-sub site-footer__btn-sub--map">Bavla, Ahmedabad</span>
          </span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="site-footer__btn-arrow">
            <path d="M7 17L17 7M17 7H7M17 7V17" />
          </svg>
        </a>

        <a
          href={callLink}
          class="site-footer__panel-btn site-footer__panel-btn--call"
          aria-label="Call Renol Foods"
        >
          <span class="site-footer__panel-badge site-footer__panel-badge--call" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="site-footer__btn-text">
            <span class="site-footer__btn-title">Call us</span>
            <span class="site-footer__btn-sub site-footer__btn-sub--call">{site.phones[0].display}</span>
          </span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="site-footer__btn-arrow">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="container site-footer__legal">
    <p>&copy; {year} {site.name}</p>
    <ul>
      {
        nav.legal.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-top: var(--s-16);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    background: var(--panel);
    border-top: 1px solid var(--line-soft);
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .site-footer__grid {
    display: grid;
    gap: var(--s-12) var(--s-8);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    }
  }
  .site-footer__brand p {
    margin-top: var(--s-4);
    max-width: 32ch;
  }
  .site-footer__licences {
    margin-top: var(--s-4);
  }
  .site-footer__brand .site-footer__founded {
    margin-top: var(--s-2);
    color: var(--ink-3);
    font-size: var(--fs-small);
  }
  h2 {
    margin-bottom: var(--s-3);
    color: var(--ink);
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__grid li a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    min-inline-size: var(--tap);
  }
  a:hover {
    color: var(--ink);
  }
  address {
    margin-top: var(--s-3);
    font-style: normal;
  }
  .site-footer__panel-container {
    margin-top: 40px;
  }
  .site-footer__panel {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    background: radial-gradient(circle at 0% 0%, rgba(255, 176, 32, 0.08) 0%, rgba(255, 176, 32, 0) 50%), rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    box-sizing: border-box;
  }
  @media (min-width: 1024px) {
    .site-footer__panel {
      padding: 32px;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
    }
  }
  .site-footer__panel-intro {
    flex-shrink: 0;
  }
  @media (min-width: 1024px) {
    .site-footer__panel-intro {
      max-width: 28rem;
    }
  }
  .site-footer__panel-title {
    margin: 0;
    color: var(--ink);
    font-family: var(--display);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.2;
  }
  @media (min-width: 1024px) {
    .site-footer__panel-title {
      font-size: 24px;
    }
  }
  .site-footer__panel-desc {
    margin: 8px 0 0;
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.45;
    max-width: 28rem;
  }
  .site-footer__panel-buttons {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
  }
  @media (min-width: 640px) {
    .site-footer__panel-buttons {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
  }
  @media (min-width: 1024px) {
    .site-footer__panel-buttons {
      flex: 1;
    }
  }
  .site-footer__panel-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 64px;
    padding: 12px;
    border-radius: 16px;
    text-decoration: none;
    box-sizing: border-box;
    min-width: 0;
    transition: transform 180ms ease, background-color 180ms ease, border-color 180ms ease;
  }
  @media (min-width: 640px) {
    .site-footer__panel-btn {
      gap: 12px;
      padding: 12px 16px;
    }
  }
  .site-footer__panel-btn:hover {
    transform: translateY(-2px);
  }
  .site-footer__panel-btn:focus-visible {
    transform: translateY(-2px);
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-footer__panel-btn {
      transition: none;
    }
    .site-footer__panel-btn:hover,
    .site-footer__panel-btn:focus-visible {
      transform: none;
    }
  }
  .site-footer__panel-btn--whatsapp {
    grid-column: 1 / -1;
    background: #128c4a;
    color: #ffffff;
  }
  @media (min-width: 640px) {
    .site-footer__panel-btn--whatsapp {
      grid-column: auto;
    }
  }
  .site-footer__panel-btn--whatsapp:hover {
    background: #16a056;
    color: #ffffff;
  }
  .site-footer__panel-btn--map {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }
  .site-footer__panel-btn--map:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }
  .site-footer__panel-btn--call {
    background: #ffb020;
    color: #140a00;
  }
  .site-footer__panel-btn--call:hover {
    background: #ffc24d;
    color: #140a00;
  }
  .site-footer__panel-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 40px;
    block-size: 40px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .site-footer__panel-badge--whatsapp {
    background: rgba(255, 255, 255, 0.18);
    color: #ffffff;
  }
  .site-footer__panel-badge--map {
    background: #2f5bea;
    color: #ffffff;
  }
  .site-footer__panel-badge--call {
    background: rgba(20, 10, 0, 0.12);
    color: #140a00;
  }
  .site-footer__btn-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
    text-align: left;
  }
  .site-footer__btn-title {
    font-weight: 700;
    font-size: 15px;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (min-width: 640px) {
    .site-footer__btn-title {
      font-size: 16px;
    }
  }
  .site-footer__btn-sub {
    font-size: 12px;
    line-height: 1.25;
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (min-width: 640px) {
    .site-footer__btn-sub {
      font-size: 14px;
    }
  }
  .site-footer__btn-sub--whatsapp,
  .site-footer__btn-sub--map {
    opacity: 0.85;
  }
  .site-footer__btn-sub--call {
    opacity: 0.85;
    color: #140a00;
  }
  .site-footer__btn-arrow {
    margin-left: auto;
    flex-shrink: 0;
    opacity: 0.7;
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-6);
    margin-top: 40px;
    padding-block: var(--s-4);
    border-top: 1px solid var(--line-soft);
    color: var(--ink-3);
    font-size: var(--fs-small);
  }
  .site-footer__legal ul {
    display: flex;
    gap: var(--s-4);
  }
  .site-footer__legal a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    min-inline-size: var(--tap);
  }
</style>
