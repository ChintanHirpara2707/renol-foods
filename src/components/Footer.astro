---
import Logo from "./ui/Logo.astro";
import { nav } from "../data/nav";
import { site } from "../data/site";
import { categories } from "../data/categories";
import { isPublic } from "../data/public";

const year = new Date().getFullYear();
const companyLinks = [...nav.primary.filter((l) => l.href !== "/products"), ...nav.secondary];
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href="/" aria-label="Renol Foods, home"><Logo /></a>
      <p>{site.description}</p>
      <p class="site-footer__founded">Founded {site.foundedYear}</p>
    </div>

    <nav aria-labelledby="footer-products">
      <h2 id="footer-products">Products</h2>
      <ul>
        {
          categories.map((c) => (
            <li>
              <a href={`/products?category=${c.slug}`}>{c.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-company">
      <h2 id="footer-company">Company</h2>
      <ul>
        {
          companyLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2>Contact</h2>
      <ul>
        {
          site.phones.map((p) => (
            <li>
              <a href={`tel:${p.tel}`}>{p.display}</a>
            </li>
          ))
        }
        {
          isPublic(site.email) && (
            <li>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </li>
          )
        }
      </ul>
      <address>
        {site.address.street}<br />
        {site.address.city}, {site.address.state}<br />
        {site.address.country}
      </address>
    </div>
  </div>

  <div class="container site-footer__legal">
    <p>&copy; {year} {site.name}</p>
    <ul>
      {
        nav.legal.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-top: var(--s-16);
    background: var(--panel);
    border-top: 1px solid var(--line-soft);
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .site-footer__grid {
    display: grid;
    gap: var(--s-12) var(--s-8);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    }
  }
  .site-footer__brand p {
    margin-top: var(--s-4);
    max-width: 32ch;
  }
  .site-footer__brand .site-footer__founded {
    margin-top: var(--s-2);
    color: var(--ink-3);
    font-size: var(--fs-small);
  }
  h2 {
    margin-bottom: var(--s-3);
    color: var(--ink);
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__grid li a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    min-inline-size: var(--tap);
  }
  a:hover {
    color: var(--ink);
  }
  address {
    margin-top: var(--s-3);
    font-style: normal;
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-6);
    margin-top: var(--s-12);
    padding-block: var(--s-4);
    border-top: 1px solid var(--line-soft);
    color: var(--ink-3);
    font-size: var(--fs-small);
  }
  .site-footer__legal ul {
    display: flex;
    gap: var(--s-4);
  }
  .site-footer__legal a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    min-inline-size: var(--tap);
  }
</style>
