---
import { products } from "../data/products";
import { categories } from "../data/categories";
import { site } from "../data/site";

/** Powder groups come from the catalogue: category title, then its product names. */
const groups = categories
  .map((c) => ({ title: c.name, items: products.filter((p) => p.category === c.id) }))
  .filter((g) => g.items.length > 0);

/** WhatsApp number, digits only (country code + number). */
const whatsapp = site.whatsappNumber.replace(/\D/g, "");
---

<form id="demo" class="demo" novalidate data-whatsapp={whatsapp}>
  <div class="grid">
    <div class="f">
      <label for="name">Full Name <span class="req" aria-hidden="true">*</span></label>
      <input id="name" name="name" type="text" autocomplete="name" required aria-describedby="e-name" />
      <p class="err" id="e-name"></p>
    </div>
    <div class="f">
      <label for="mobile">Mobile Number <span class="req" aria-hidden="true">*</span></label>
      <input id="mobile" name="mobile" type="tel" inputmode="tel" autocomplete="tel" placeholder="e.g. 98765 43210" required aria-describedby="e-mobile" />
      <p class="err" id="e-mobile"></p>
    </div>
    <div class="f">
      <label for="company">Company Name <span class="req" aria-hidden="true">*</span></label>
      <input id="company" name="company" type="text" autocomplete="organization" required aria-describedby="e-company" />
      <p class="err" id="e-company"></p>
    </div>
    <div class="f">
      <label for="email">Email Address <span class="req" aria-hidden="true">*</span></label>
      <input id="email" name="email" type="email" inputmode="email" autocomplete="email" required aria-describedby="e-email" />
      <p class="err" id="e-email"></p>
    </div>
    <div class="f full">
      <label for="address">Address <span class="req" aria-hidden="true">*</span></label>
      <textarea id="address" name="address" autocomplete="street-address" required aria-describedby="e-address"></textarea>
      <p class="err" id="e-address"></p>
    </div>
  </div>

  <fieldset class="pw" id="powders" aria-describedby="e-powders">
    <legend>Choose Powders <span class="req" aria-hidden="true">*</span></legend>
    <div class="bar">
      <span class="count" id="count" aria-live="polite"><b>0</b> powders selected</span>
      <button type="button" class="pill" id="clear" disabled>Clear Selection</button>
    </div>
    <p class="err pwerr" id="e-powders"></p>

    <div id="cats">
      {
        groups.map((g, ci) => (
          <fieldset class="cat" data-title={g.title}>
            <legend>
              {g.title} <small id={`n${ci}`}>{g.items.length} {g.items.length === 1 ? "product" : "products"}</small>
            </legend>
            <div class="chips">
              {g.items.map((p) => (
                <label class="chip">
                  <input type="checkbox" name="powder" value={p.slug} data-cat={ci} data-name={p.name} />
                  <span class="body">
                    <span class="box">
                      <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M2.5 7.5l3 3 6-7" />
                      </svg>
                    </span>
                    <span>{p.name}</span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
        ))
      }
    </div>
  </fieldset>

  <p class="sum" id="sum" role="alert" tabindex="-1">Please fix the highlighted fields and try again.</p>

  <div class="go">
    <button class="btn-accent submit" type="submit">Request for Sample</button>
    <p class="note">WhatsApp will open with your details ready. Please press Send there to deliver your request.</p>
  </div>
  <div class="status" id="status" role="status"></div>
</form>

<script>
  import "../scripts/demo-form";
</script>

<style>
  .demo {
    --err: #ff9a90;
    --field: var(--surface);
    margin-top: var(--s-8);
    padding: clamp(1.125rem, 4vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
    background: var(--panel);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.125rem 1.25rem;
  }
  .full {
    grid-column: 1 / -1;
  }
  .f label {
    display: block;
    margin: 0 0 0.45rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .req {
    color: var(--accent);
  }
  input[type="text"],
  input[type="tel"],
  input[type="email"],
  textarea {
    width: 100%;
    min-height: var(--tap);
    padding: 0.8rem 0.875rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--field);
    color: var(--ink);
    font: inherit;
    font-size: 16px; /* no iOS zoom on focus */
  }
  textarea {
    min-height: 6rem;
    resize: vertical;
  }
  input::placeholder,
  textarea::placeholder {
    color: var(--ink-3);
  }
  input:hover,
  textarea:hover {
    border-color: rgba(255, 255, 255, 0.3);
  }
  [aria-invalid="true"] {
    border-color: var(--err) !important;
  }
  .err {
    margin: 0.4rem 0 0;
    font-size: 0.8125rem;
    color: var(--err);
  }
  .err:empty {
    display: none;
  }

  .pw {
    min-width: 0;
    margin: 1.875rem 0 0;
    padding: 0;
    border: 0;
  }
  .pw > legend {
    padding: 0;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.625rem;
    margin: 0.5rem 0 0.375rem;
  }
  .count {
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .count :global(b) {
    color: var(--accent);
    font-weight: 600;
  }
  #clear:disabled {
    opacity: 0.4;
    cursor: default;
    transform: none;
  }
  .pwerr {
    margin-top: 0.625rem;
  }

  .cat {
    min-width: 0;
    margin: 1.25rem 0 0;
    padding: 0;
    border: 0;
  }
  .cat > legend {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    width: 100%;
    padding: 0 0 0.625rem;
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .cat > legend small {
    font-family: var(--body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink-3);
  }
  .cat > legend :global(small.on),
  .cat > legend small.on {
    color: var(--accent);
  }
  .chips {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
  }
  .chip {
    position: relative;
    display: block;
    cursor: pointer;
  }
  .chip input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .body {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: var(--tap);
    padding: 0.6875rem 0.8125rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--field);
    font-size: 0.9375rem;
    transition: border-color var(--dur-1) var(--ease-out), background-color var(--dur-1) var(--ease-out);
  }
  .box {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    border-radius: 0.375rem;
    color: var(--on-accent);
  }
  .box svg {
    width: 0.8125rem;
    height: 0.8125rem;
    opacity: 0;
  }
  .chip:hover .body {
    border-color: rgba(255, 255, 255, 0.34);
  }
  .chip input:checked + .body {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 13%, transparent);
  }
  .chip input:checked + .body .box {
    border-color: var(--accent);
    background: var(--accent);
  }
  .chip input:checked + .body .box svg {
    opacity: 1;
  }
  .chip input:focus-visible + .body {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .sum {
    display: none;
    margin: 1.375rem 0 0;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--err);
    border-radius: 0.75rem;
    font-size: 0.875rem;
    color: var(--err);
  }
  .sum:global(.show) {
    display: block;
  }
  .go {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
    margin-top: 1.625rem;
  }
  .submit {
    min-height: 3.25rem;
    padding: 0 2.125rem;
    font-size: 1.0625rem;
  }
  .note {
    max-width: 46ch;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .status {
    display: none;
    margin-top: 1.25rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 0.875rem;
    background: var(--field);
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .status:global(.show) {
    display: block;
  }
  .status :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }
  .status :global(pre) {
    margin: 0.625rem 0 0;
    padding: 0.75rem;
    border-radius: 0.625rem;
    background: var(--bg);
    font: inherit;
    font-size: 0.8125rem;
    color: var(--ink);
    white-space: pre-wrap;
    word-break: break-word;
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .submit {
      width: 100%;
    }
    .chips {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .body {
      transition: none;
    }
  }
</style>
