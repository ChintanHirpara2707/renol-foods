---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { industries } from "../data/industries";
---

<BaseLayout
  title="Industries Served | Renol Foods Bavla"
  description="Supplying industrial bakeries, extruded snack seasoning blenders, instant beverage formulators, and merchant food exporters worldwide with dehydrated and spray-dried food powders."
>
  <!-- Hero Section -->
  <section class="relative py-20 lg:py-28 border-b border-white/10 overflow-hidden">
    <!-- Ambient Radial Glow -->
    <div
      class="pointer-events-none absolute left-1/2 top-10 -translate-x-1/2 w-[700px] h-[350px] rounded-full blur-[140px] opacity-20"
      style="background: radial-gradient(circle, #f59e0b 0%, transparent 70%);"
      aria-hidden="true"
    ></div>

    <div class="section-container relative z-10">
      <SectionHeading
        level={1}
        eyebrow="Market Applications"
        title="Formulated for Industrial Segments"
        subtitle="Engineered to integrate cleanly into automated production lines, dry blending, topical dusting, and high-speed packaging."
      />

      <!-- Hero Primary Action Button (1 per hero) -->
      <div class="mt-8 flex justify-center">
        <a href="/request-sample" class="btn-accent min-h-[44px]">
          Request a Sample
        </a>
      </div>

      <!-- Industries Grid: 4 cols on desktop, 2 on tablet, 1 on mobile -->
      <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          industries.map((item) => (
            <div class="group relative bg-[#121214] p-7 rounded-3xl border border-white/10 hover:border-white/25 transition-all duration-300 flex flex-col justify-between overflow-hidden">
              <div>
                <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-amber-400 font-display font-bold text-lg mb-4 group-hover:scale-105 transition-transform">
                  &bull;
                </div>
                <h2 class="font-display text-xl font-bold text-white mb-2 group-hover:text-amber-300 transition-colors">
                  {item.name}
                </h2>
                <p class="text-sm text-white/70 leading-relaxed font-body">
                  {item.description}
                </p>
              </div>

              <!-- Industry card action: 1 text link per card ("View details →") -->
              <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between">
                <a
                  href="/products"
                  class="text-xs font-semibold text-amber-400 hover:text-amber-300 transition-colors inline-flex items-center gap-1 min-h-[44px]"
                >
                  <span>View details</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
                <span class="text-[11px] text-white/60 font-mono">B2B Supply</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- One Closing CTA Section Near the End of the Page -->
  <section class="py-20 bg-[#0e0e12] text-white text-center border-t border-white/10">
    <div class="section-container max-w-3xl">
      <span class="text-xs uppercase font-bold tracking-widest text-white/60 block mb-3 font-mono">Custom Formulations</span>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold mb-4 tracking-tight">
        Need tailored powder specifications for your application?
      </h2>
      <p class="text-white/70 text-sm sm:text-base mb-8 max-w-xl mx-auto leading-relaxed font-body">
        We calibrate mesh sizes, carrier balances, and moisture limits for commercial production runs.
      </p>
      <a href="/request-sample" class="btn-accent min-h-[44px]">
        Request a Sample
      </a>
    </div>
  </section>
</BaseLayout>
