---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import LicenceBadges from "../components/LicenceBadges.astro";
import ContactButtons from "../components/ContactButtons.astro";
import { industries, industryProducts } from "../data/industries";
import { factoryPhotos } from "../data/factory";

const MAX_PRODUCTS = 6;
const cards = industries.map((industry) => {
  const all = industryProducts(industry);
  return { industry, shown: all.slice(0, MAX_PRODUCTS), more: Math.max(0, all.length - MAX_PRODUCTS) };
});
---

<BaseLayout
  title="Industries | Renol Foods"
  description="Renol Foods supplies food powders to bakery and confectionery, beverages and juices, snacks and seasonings, soups, sauces and ready mixes, dairy and ice cream, and nutraceutical and health food makers."
>
  <section class="hero">
    <div class="container">
      <SectionHeading
        level={1}
        eyebrow="Industries"
        title="Powders for every kind of food maker"
        subtitle="Six industries we supply, and the powders that suit each one."
        align="left"
      />
    </div>
  </section>

  <section class="industries" aria-label="Industries we supply">
    <div class="container">
      <ul class="grid">
        {
          cards.map(({ industry, shown, more }, i) => (
            <li class:list={["icard", i % 2 === 0 ? "icard--text-left" : "icard--text-right"]}>
              <img
                src={industry.image}
                alt=""
                width="1200"
                height="800"
                loading={i < 2 ? "eager" : "lazy"}
                decoding="async"
              />
              <div class="icard__shade" aria-hidden="true"></div>
              <div class="icard__body">
                <h2>{industry.name}</h2>
                <p>{industry.description}</p>
                {shown.length > 0 && (
                  <ul class="icard__products" aria-label={`Relevant products for ${industry.name}`}>
                    {shown.map((p) => (
                      <li>
                        <a href={`/products/${p.slug}`}>{p.name}</a>
                      </li>
                    ))}
                    {more > 0 && (
                      <li>
                        <a href="/products" class="icard__more">+{more} more</a>
                      </li>
                    )}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="factory" aria-label="Factory and machinery">
    <div class="container">
      <SectionHeading
        eyebrow="Inside the plant"
        title="Our factory and machinery"
        subtitle="The factory and the machinery used in manufacturing."
        align="left"
      />
      <ul class="gallery">
        {
          factoryPhotos.map((photo) => (
            <li>
              <figure>
                <img src={photo.image} alt={photo.alt} width="1200" height="800" loading="lazy" decoding="async" />
                <figcaption>{photo.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="licences-strip" aria-labelledby="licences-title">
    <div class="container">
      <h2 id="licences-title">Licences and certifications</h2>
      <LicenceBadges align="center" />
    </div>
  </section>

  <section class="closing" aria-labelledby="closing-title">
    <div class="container">
      <h2 id="closing-title">Talk to Renol Foods</h2>
      <p>Message us on WhatsApp, call the plant, or find us on the map.</p>
      <ContactButtons />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--s-16) var(--s-8);
    background: radial-gradient(60% 80% at 85% 0%, rgba(255, 176, 32, 0.14), transparent), var(--bg);
  }
  .industries {
    padding-block: var(--s-8) var(--section-y);
  }
  .grid {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .grid {
      gap: var(--s-6);
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    /* alternating widths: 7/5, 5/7, 7/5 */
    .icard:nth-child(4n + 1),
    .icard:nth-child(4n + 4) {
      grid-column: span 7;
    }
    .icard:nth-child(4n + 2),
    .icard:nth-child(4n + 3) {
      grid-column: span 5;
    }
  }

  .icard {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(22rem, 52vw, 30rem);
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--line-soft);
    border-radius: var(--r-panel);
    background: var(--panel);
    content-visibility: auto;
    contain-intrinsic-size: auto 28rem;
  }
  @media (min-width: 900px) {
    .icard {
      min-height: 30rem;
    }
  }
  .icard img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .icard:hover img,
  .icard:focus-within img {
    transform: scale(1.04);
  }
  .icard__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(8, 8, 10, 0.92) 8%, rgba(8, 8, 10, 0.55) 48%, rgba(8, 8, 10, 0.12) 100%);
  }
  .icard__body {
    width: 100%;
    padding: var(--s-6);
  }
  .icard--text-right .icard__body {
    text-align: end;
  }
  .icard h2 {
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .icard p {
    max-width: 38ch;
    margin-top: var(--s-2);
    color: rgba(255, 255, 255, 0.86);
  }
  .icard--text-right p {
    margin-inline-start: auto;
  }
  .icard__products {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: var(--s-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .icard--text-right .icard__products {
    justify-content: flex-end;
  }
  .icard__products a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--s-4);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--r-pill);
    background: rgba(11, 11, 13, 0.55);
    color: #fff;
    font-size: var(--fs-small);
    font-weight: 500;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transition: background-color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
  }
  .icard__products a:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: #fff;
  }
  .icard__more {
    font-weight: 600;
  }

  .factory {
    padding-block: 0 var(--section-y);
  }
  .gallery {
    display: grid;
    gap: var(--s-4);
    margin: var(--s-8) 0 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .gallery {
      gap: var(--s-6);
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .gallery li {
    content-visibility: auto;
    contain-intrinsic-size: auto 18rem;
  }
  .gallery figure {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    border-radius: var(--r-card);
    background: var(--surface);
  }
  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .gallery figure:hover img {
    transform: scale(1.03);
  }
  .gallery figure {
    overflow: hidden;
  }
  .gallery figcaption {
    padding: var(--s-3) var(--s-4);
    color: var(--ink-2);
    font-size: var(--fs-small);
  }

  .licences-strip {
    padding-block: var(--s-12);
    border-block: 1px solid var(--line-soft);
    background: var(--panel);
    text-align: center;
  }
  .licences-strip h2 {
    margin-bottom: var(--s-4);
    color: var(--ink-2);
    font-family: var(--body);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .closing {
    padding-block: var(--section-y);
    text-align: center;
  }
  .closing h2 {
    font-size: var(--fs-h2);
    font-weight: 800;
    letter-spacing: -0.025em;
  }
  .closing p {
    margin: var(--s-3) auto var(--s-8);
    max-width: 40ch;
    color: var(--ink-2);
  }
</style>
