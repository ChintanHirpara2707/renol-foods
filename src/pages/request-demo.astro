---
import BaseLayout from "../layouts/BaseLayout.astro";
import DemoForm from "../components/DemoForm.astro";
---

<BaseLayout
  title="Request for Sample"
  description="Choose your powders and send your details to Renol Foods to request a product sample. Your request opens in WhatsApp."
>
  <section class="demo-page">
    <div class="container demo-page__wrap">
      <h1>Request for Sample</h1>
      <p class="demo-page__sub">
        Interested in our products? Select your preferred powders and submit
        your details to request a product sample.
      </p>
      <DemoForm />
    </div>
  </section>
</BaseLayout>

<style>
  .demo-page {
    padding-block: var(--s-12) var(--section-y);
    background:
      radial-gradient(
        70% 40% at 50% 0%,
        rgba(242, 122, 0, 0.18),
        transparent 70%
      ),
      var(--bg);
  }
  .demo-page__wrap {
    max-width: 54rem;
  }
  h1 {
    font-size: clamp(2.375rem, 7vw, 4rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .demo-page__sub {
    max-width: 60ch;
    margin-top: var(--s-4);
    color: var(--ink-2);
    font-size: 1.0625rem;
  }
</style>
