---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChatLink from "../components/ChatLink.astro";
import SectionHeading from "../components/SectionHeading.astro";
---

<BaseLayout
  title="Global Export Supply & Logistics | Renol Foods Bavla"
  description="Supplying overseas food processors and importers worldwide with dehydrated and spray-dried food powders dispatched via Mundra and Pipavav ports."
>
  <!-- Hero Section -->
  <section class="relative py-20 lg:py-28 border-b border-white/10 overflow-hidden">
    <!-- Ambient Radial Glow -->
    <div
      class="pointer-events-none absolute left-1/2 top-10 -translate-x-1/2 w-[700px] h-[350px] rounded-full blur-[140px] opacity-20"
      style="background: radial-gradient(circle, #38bdf8 0%, transparent 70%);"
      aria-hidden="true"
    ></div>

    <div class="section-container relative z-10">
      <SectionHeading
        level={1}
        eyebrow="International Supply"
        title="Global Export Infrastructure & Logistics"
        subtitle="Engineered for ocean freight stability, moisture protection, and smooth customs clearance for food manufacturers worldwide."
      />

      <!-- Hero Primary Action Button (1 per hero) -->
      <div class="mt-8 flex justify-center">
        <ChatLink class="btn-accent min-h-[44px]" />
      </div>

      <!-- Export Capabilities Grid: 3 cols desktop, 2 tablet, 1 mobile -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="p-8 rounded-3xl bg-[#121214] border border-white/10 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-amber-400 font-display font-bold text-lg mb-4">
              01
            </div>
            <h2 class="font-display text-2xl font-bold text-white mb-2">
              Port Connectivity
            </h2>
            <p class="text-sm text-white/70 leading-relaxed font-body">
              Located in Bavla, Ahmedabad, with seamless highway transit to major container ports including Mundra and Pipavav in Gujarat, facilitating rapid FCL and LCL ocean shipments.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-white/10 text-xs text-amber-400 font-mono">
            Direct access to Mundra & Pipavav
          </div>
        </div>

        <div class="p-8 rounded-3xl bg-[#121214] border border-white/10 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-amber-400 font-display font-bold text-lg mb-4">
              02
            </div>
            <h2 class="font-display text-2xl font-bold text-white mb-2">
              Moisture-Barrier Export Packing
            </h2>
            <p class="text-sm text-white/70 leading-relaxed font-body">
              Heavy-duty multi-wall paper bags with airtight heat-sealed LDPE inner liners or vacuum foil bags, preventing humidity absorption across tropical sea voyages.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-white/10 text-xs text-amber-400 font-mono">
            Palletized & stretch-wrapped containers
          </div>
        </div>

        <div class="p-8 rounded-3xl bg-[#121214] border border-white/10 flex flex-col justify-between md:col-span-2 lg:col-span-1">
          <div>
            <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-amber-400 font-display font-bold text-lg mb-4">
              03
            </div>
            <h2 class="font-display text-2xl font-bold text-white mb-2">
              Export Compliance Documents
            </h2>
            <p class="text-sm text-white/70 leading-relaxed font-body">
              Complete technical shipping dossier including Certificate of Analysis (COA), Certificate of Origin, Packing List, Commercial Invoice, and fumigation documentation.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-white/10 text-xs text-amber-400 font-mono">
            Full destination documentation support
          </div>
        </div>
      </div>

      <!-- Container Loading Specifications Table in responsive container -->
      <div class="mt-16 bg-[#121214] border border-white/10 rounded-3xl p-6 sm:p-8">
        <div class="mb-6">
          <h2 class="font-display text-xl sm:text-2xl font-bold text-white">
            Container Loading & Freight Benchmarks
          </h2>
          <p class="text-sm text-white/70 mt-1">
            General packing and stuffing benchmarks for export shipments.
          </p>
        </div>

        <div class="table-responsive" tabindex="0" role="region" aria-label="Table, scrolls horizontally on small screens">
          <table class="w-full text-left text-sm text-white/80 min-w-[540px]">
            <thead class="border-b border-white/10 text-xs uppercase text-white/50 font-mono bg-white/5">
              <tr>
                <th scope="col" class="py-3 px-4">Container Format</th>
                <th scope="col" class="py-3 px-4">Primary Packing</th>
                <th scope="col" class="py-3 px-4">Estimated Capacity</th>
                <th scope="col" class="py-3 px-4">Palletizing Standard</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5 font-body">
              <tr>
                <td class="py-3.5 px-4 font-medium text-white">20 ft Standard FCL</td>
                <td class="py-3.5 px-4 text-white/70">20 kg / 25 kg multi-wall kraft bags</td>
                <td class="py-3.5 px-4 font-mono text-xs text-amber-300">10 to 12 Metric Tonnes</td>
                <td class="py-3.5 px-4 text-white/60">ISPM-15 heat-treated wooden pallets</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-medium text-white">40 ft Standard FCL</td>
                <td class="py-3.5 px-4 text-white/70">20 kg / 25 kg multi-wall kraft bags</td>
                <td class="py-3.5 px-4 font-mono text-xs text-amber-300">22 to 24 Metric Tonnes</td>
                <td class="py-3.5 px-4 text-white/60">ISPM-15 heat-treated wooden pallets</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-medium text-white">LCL Consignments</td>
                <td class="py-3.5 px-4 text-white/70">Fiber drums / heavy cartons</td>
                <td class="py-3.5 px-4 font-mono text-xs text-amber-300">Custom volume on request</td>
                <td class="py-3.5 px-4 text-white/60">Corner-board protected pallet boxes</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </section>

  <!-- One Closing CTA Section Near the End of the Page -->
  <section class="py-20 bg-[#0e0e12] text-white text-center border-t border-white/10">
    <div class="section-container max-w-3xl">
      <span class="text-xs uppercase font-bold tracking-widest text-white/60 block mb-3 font-mono">International Buyers</span>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold mb-4 tracking-tight">
        Talk to us about export supply
      </h2>
      <p class="text-white/70 text-sm sm:text-base mb-8 max-w-xl mx-auto leading-relaxed font-body">
        Our export desk provides CIF and FOB rate indications, shipping lead times, and dispatch coordination for overseas ports.
      </p>
      <ChatLink class="btn-accent min-h-[44px]" />
    </div>
  </section>
</BaseLayout>
