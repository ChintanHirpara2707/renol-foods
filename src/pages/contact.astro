---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { siteConfig } from "../data/site";

const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || "";
const displayAddress = siteConfig.location.fullAddress.replace(/\[.*?\]/g, "").trim();
const isEmailConfirmed = !siteConfig.contact.email.includes("[CONFIRM");
const isHoursConfirmed = !siteConfig.workingHours.includes("[CONFIRM");
---

<BaseLayout
  title="Request a Sample | Renol Foods"
  description="Contact Renol Foods sales desk in Bavla, Ahmedabad. Request product samples and commercial price quotes for food powders."
>
  <section class="py-16 lg:py-24 bg-cream">
    <div class="section-container">
      <SectionHeading
        eyebrow="Commercial Inquiries"
        title="Request a Sample"
        subtitle="Connect directly with our team in Bavla to discuss product specifications, bulk orders, or request a sample for formulation trials."
      />

      <div class="mt-14 grid grid-cols-1 lg:grid-cols-12 gap-12 max-w-6xl mx-auto">
        
        <!-- Left Column: Contact Information (5 cols) -->
        <div class="lg:col-span-5 space-y-8 bg-cream-50 p-8 rounded-3xl border border-green-black/10">
          <div>
            <h3 class="font-serif text-2xl font-bold text-green-black">
              Sales & Inquiries
            </h3>
            <p class="mt-2 text-sm text-forest-700 leading-relaxed">
              For product sample requests, volume orders, or formulation inquiries:
            </p>
          </div>

          <div class="space-y-6 text-sm text-forest-800">
            <!-- Direct Phone Lines -->
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-forest-500 mb-2">Direct Phone Lines</p>
              <div class="space-y-1.5">
                {
                  siteConfig.contact.displayPhones.map((phone, idx) => (
                    <a
                      href={`tel:${siteConfig.contact.phones[idx]}`}
                      class="flex items-center gap-3 p-2 rounded-xl hover:bg-cream-200 transition-colors font-medium text-green-black"
                    >
                      <svg class="w-4 h-4 text-forest-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                      </svg>
                      <span>{phone}</span>
                    </a>
                  ))
                }
              </div>
            </div>

            <!-- Email Inquiries (Only shown if confirmed) -->
            {
              isEmailConfirmed && (
                <div>
                  <p class="text-xs font-bold uppercase tracking-wider text-forest-500 mb-1">Corporate & Sales Email</p>
                  <p class="font-mono text-xs bg-cream-200/80 p-3 rounded-xl border border-green-black/10 text-green-black break-words">
                    {siteConfig.contact.email}
                  </p>
                </div>
              )
            }

            <!-- Manufacturing Address -->
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-forest-500 mb-1">Manufacturing Location</p>
              <p class="text-xs leading-relaxed text-forest-700 bg-cream-200/80 p-3 rounded-xl border border-green-black/10">
                {displayAddress}
              </p>
            </div>

            <!-- Operating Hours -->
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-forest-500 mb-1">Business Hours</p>
              <p class="text-xs text-forest-700">
                {isHoursConfirmed ? siteConfig.workingHours : "Monday – Saturday (IST)"}
              </p>
            </div>
          </div>
        </div>

        <!-- Right Column: Lead Capture Form (7 cols) -->
        <div id="sample-quote" class="lg:col-span-7 bg-cream-50 p-8 sm:p-10 rounded-3xl border border-green-black/10 shadow-sm scroll-mt-28">
          <div class="mb-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-tomato/10 text-tomato text-xs font-bold uppercase tracking-wider mb-2">
              Commercial Inquiries
            </span>
            <h3 class="font-serif text-2xl font-bold text-green-black">
              Request a Sample
            </h3>
            <p class="text-xs text-forest-600 mt-1">
              B2B supply for food manufacturers, bakeries, snack brands, and exporters.
            </p>
          </div>

          <form
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-4"
          >
            <!-- Web3Forms Config -->
            <input type="hidden" name="access_key" value={web3FormsKey} />
            <input type="hidden" name="subject" value="New B2B Sample & Quote Request - Renol Foods" />
            <input type="hidden" name="from_name" value="Renol Foods Website" />
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-bold uppercase tracking-wider text-forest-700 mb-1">
                  Full Name *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. Ramesh Shah"
                  class="w-full px-4 py-2.5 rounded-xl bg-cream border border-green-black/15 text-sm text-green-black placeholder:text-forest-400 focus:outline-none focus:ring-2 focus:ring-forest-700"
                />
              </div>

              <div>
                <label for="company" class="block text-xs font-bold uppercase tracking-wider text-forest-700 mb-1">
                  Company / Brand Name *
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  required
                  placeholder="e.g. Heritage Foods Ltd."
                  class="w-full px-4 py-2.5 rounded-xl bg-cream border border-green-black/15 text-sm text-green-black placeholder:text-forest-400 focus:outline-none focus:ring-2 focus:ring-forest-700"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-forest-700 mb-1">
                  Business Email *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="purchasing@company.com"
                  class="w-full px-4 py-2.5 rounded-xl bg-cream border border-green-black/15 text-sm text-green-black placeholder:text-forest-400 focus:outline-none focus:ring-2 focus:ring-forest-700"
                />
              </div>

              <div>
                <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-forest-700 mb-1">
                  Phone / WhatsApp *
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="+91 98765 43210"
                  class="w-full px-4 py-2.5 rounded-xl bg-cream border border-green-black/15 text-sm text-green-black placeholder:text-forest-400 focus:outline-none focus:ring-2 focus:ring-forest-700"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="product" class="block text-xs font-bold uppercase tracking-wider text-forest-700 mb-1">
                  Target Product *
                </label>
                <select
                  id="product"
                  name="product"
                  required
                  class="w-full px-4 py-2.5 rounded-xl bg-cream border border-green-black/15 text-sm text-green-black focus:outline-none focus:ring-2 focus:ring-forest-700"
                >
                  <option value="">Select a powder...</option>
                  {siteConfig.products.map((p) => (
                    <option value={p.name}>{p.name}</option>
                  ))}
                  <option value="Multiple Powders">Multiple Powders / Custom Premix</option>
                </select>
              </div>

              <div>
                <label for="inquiryType" class="block text-xs font-bold uppercase tracking-wider text-forest-700 mb-1">
                  Request Type *
                </label>
                <select
                  id="inquiryType"
                  name="inquiryType"
                  required
                  class="w-full px-4 py-2.5 rounded-xl bg-cream border border-green-black/15 text-sm text-green-black focus:outline-none focus:ring-2 focus:ring-forest-700"
                >
                  <option value="Sample Request">Product Sample</option>
                  <option value="Commercial Quote">Commercial Quote</option>
                  <option value="Both">Sample & Pricing</option>
                  <option value="Export Inquiry">Export Inquiry</option>
                </select>
              </div>
            </div>

            <div>
              <label for="message" class="block text-xs font-bold uppercase tracking-wider text-forest-700 mb-1">
                Application & Expected Volume
              </label>
              <textarea
                id="message"
                name="message"
                rows="3"
                placeholder="Specify your application (e.g. snack seasoning, bakery, beverage), required volume, or packaging preference..."
                class="w-full px-4 py-2.5 rounded-xl bg-cream border border-green-black/15 text-sm text-green-black placeholder:text-forest-400 focus:outline-none focus:ring-2 focus:ring-forest-700"
              ></textarea>
            </div>

            <button
              type="submit"
              class="btn-accent w-full text-base !py-3.5 shadow-md mt-2"
            >
              Request a Sample
            </button>

            <p class="text-[11px] text-center text-forest-500 pt-1">
              Strictly B2B. Information provided is used only for commercial correspondence and sample coordination.
            </p>
          </form>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
