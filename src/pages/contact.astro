---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import { site, whatsappLink, callLink } from "../data/site";
import { CTA } from "../data/cta";
import { isPublic } from "../data/public";

const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(site.address.line)}&output=embed`;
---

<BaseLayout
  title="Contact | Renol Foods Bavla"
  description="Contact Renol Foods in Bavla, Ahmedabad: chat on WhatsApp, call, or open the location in Google Maps."
>
  <section class="relative py-20 lg:py-28 border-b border-white/10">
    <div class="section-container relative z-10">
      <SectionHeading
        level={1}
        eyebrow="Contact"
        title="Talk to Renol Foods"
        subtitle="Message us on WhatsApp, call us, or find the plant on the map."
      />

      <div class="big-actions">
        <a class="big big--whatsapp" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
          <span class="big__title">{CTA.chat.label}</span>
          <span class="big__sub">{site.whatsappNumber}</span>
        </a>
        <a class="big big--call" href={callLink}>
          <span class="big__title">Call us</span>
          <span class="big__sub">{site.phones[0].display}</span>
        </a>
        <a class="big big--map" href={site.mapUrl} target="_blank" rel="noopener noreferrer">
          <span class="big__title">Open in Google Maps</span>
          <span class="big__sub">Bavla, Ahmedabad</span>
        </a>
      </div>

      <div class="details">
        <section class="card" aria-labelledby="contact-address">
          <h2 id="contact-address">Address</h2>
          <address>
            {site.address.street}<br />
            {site.address.city}, {site.address.state}<br />
            {site.address.country}
          </address>
        </section>

        <section class="card" aria-labelledby="contact-phones">
          <h2 id="contact-phones">Phone</h2>
          <ul>
            {
              site.phones.map((p) => (
                <li>
                  <a href={`tel:${p.tel}`}>{p.display}</a>
                </li>
              ))
            }
          </ul>
        </section>

        {
          (isPublic(site.hours) || isPublic(site.email)) && (
            <section class="card" aria-labelledby="contact-more">
              <h2 id="contact-more">More</h2>
              <ul>
                {isPublic(site.hours) && <li>Hours: {site.hours}</li>}
                {
                  isPublic(site.email) && (
                    <li>
                      <a href={`mailto:${site.email}`}>{site.email}</a>
                    </li>
                  )
                }
              </ul>
            </section>
          )
        }
      </div>

      <div class="map">
        <iframe
          title="Renol Foods location on Google Maps"
          src={mapEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
      <div class="map-link">
        <Button href={site.mapUrl} variant="ghost" target="_blank" rel="noopener noreferrer">Open in Google Maps</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .big-actions {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-12);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .big {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.125rem;
    min-height: 5rem;
    padding: var(--s-4) var(--s-6);
    border-radius: var(--r-card);
    color: #fff;
    transition: transform var(--dur-1) var(--ease-out), filter var(--dur-1) var(--ease-out);
  }
  .big:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }
  .big--whatsapp {
    background: #0f7a40;
  }
  .big--map {
    background: #2456d4;
  }
  .big--call {
    background: var(--accent);
    color: var(--on-accent);
  }
  .big__title {
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 800;
  }
  .big__sub {
    font-size: var(--fs-small);
    opacity: 0.9;
  }

  .details {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-8);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .card {
    padding: var(--s-6);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-card);
    background: var(--panel);
    color: var(--ink-2);
  }
  .card h2 {
    margin-bottom: var(--s-3);
    color: var(--ink);
    font-family: var(--display);
    font-size: 1.125rem;
    font-weight: 800;
  }
  .card address {
    font-style: normal;
  }
  .card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card li a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--line);
  }

  .map {
    margin-top: var(--s-8);
    overflow: hidden;
    border: 1px solid var(--line-soft);
    border-radius: var(--r-panel);
    background: var(--panel);
  }
  .map iframe {
    display: block;
    width: 100%;
    height: clamp(18rem, 45svh, 28rem);
    border: 0;
  }
  .map-link {
    display: flex;
    justify-content: center;
    margin-top: var(--s-4);
  }
</style>
