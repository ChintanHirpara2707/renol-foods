---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { siteConfig } from "../data/site";

const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || "";
const displayAddress = siteConfig.location.fullAddress.replace(/\[.*?\]/g, "").trim();
const isEmailConfirmed = !siteConfig.contact.email.includes("[CONFIRM");
const isHoursConfirmed = !siteConfig.workingHours.includes("[CONFIRM");
---

<BaseLayout
  title="Request a Sample & Inquiries | Renol Foods Bavla"
  description="Contact Renol Foods commercial sales desk in Bavla, Ahmedabad. Request product samples, custom mesh calibrations, and commercial price quotes for industrial food powders."
>
  <!-- Hero Section -->
  <section class="relative py-16 lg:py-24 border-b border-white/10 overflow-hidden">
    <!-- Ambient Radial Glow -->
    <div
      class="pointer-events-none absolute left-1/2 top-10 -translate-x-1/2 w-[700px] h-[350px] rounded-full blur-[140px] opacity-20"
      style="background: radial-gradient(circle, #f59e0b 0%, transparent 70%);"
      aria-hidden="true"
    ></div>

    <div class="section-container relative z-10 font-body">
      <SectionHeading
        eyebrow="Commercial Inquiries"
        title="Request a Sample"
        subtitle="Connect directly with our manufacturing desk in Bavla to discuss product specifications, custom mesh milling, or request evaluation samples for your formulation trials."
      />

      <div class="mt-14 grid grid-cols-1 lg:grid-cols-12 gap-10 max-w-6xl mx-auto">
        
        <!-- Left Column: Contact Information (5 cols) -->
        <div class="lg:col-span-5 space-y-8 bg-[#121214] p-7 sm:p-9 rounded-3xl border border-white/10">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2 h-2 rounded-full bg-amber-400"></span>
              <h3 class="font-display text-2xl font-bold text-white tracking-tight">
                Sales & Factory Desk
              </h3>
            </div>
            <p class="text-sm text-white/70 leading-relaxed font-body">
              For product sample dispatch, volume pricing, or technical formulation support:
            </p>
          </div>

          <div class="space-y-6 text-sm text-white/80">
            <!-- Direct Phone Lines -->
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-white/40 mb-2 font-mono">
                Direct Phone Lines
              </p>
              <div class="space-y-2">
                {
                  siteConfig.contact.displayPhones.map((phone, idx) => (
                    <a
                      href={`tel:${siteConfig.contact.phones[idx]}`}
                      class="flex items-center gap-3 p-3 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 hover:border-white/15 transition-all font-medium text-white min-h-[44px]"
                    >
                      <svg class="w-5 h-5 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                      </svg>
                      <span>{phone}</span>
                    </a>
                  ))
                }
              </div>
            </div>

            <!-- Email Inquiries (Only shown if confirmed) -->
            {
              isEmailConfirmed && (
                <div>
                  <p class="text-xs font-bold uppercase tracking-wider text-white/40 mb-1.5 font-mono">
                    Corporate Email
                  </p>
                  <p class="font-mono text-xs bg-white/5 p-3.5 rounded-xl border border-white/10 text-white/90 break-words">
                    {siteConfig.contact.email}
                  </p>
                </div>
              )
            }

            <!-- Manufacturing Address -->
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-white/40 mb-1.5 font-mono">
                Manufacturing Location
              </p>
              <div class="text-xs leading-relaxed text-white/70 bg-white/5 p-3.5 rounded-xl border border-white/10 space-y-1">
                <p class="font-semibold text-white">{siteConfig.name}</p>
                <p>{displayAddress}</p>
              </div>
            </div>

            <!-- Operating Hours -->
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-white/40 mb-1 font-mono">
                Plant Hours
              </p>
              <p class="text-xs text-white/70">
                {isHoursConfirmed ? siteConfig.workingHours : "Monday – Saturday 9:00 AM – 6:00 PM (IST)"}
              </p>
            </div>
          </div>
        </div>

        <!-- Right Column: Lead Capture Form (7 cols) -->
        <div id="sample-quote" class="lg:col-span-7 bg-[#121214] p-7 sm:p-10 rounded-3xl border border-white/10 shadow-xl scroll-mt-28">
          <div class="mb-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 text-amber-400 text-xs font-bold uppercase tracking-wider mb-2 font-mono">
              B2B Commercial Request
            </span>
            <h3 class="font-display text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
              Request a Sample
            </h3>
            <p class="text-xs sm:text-sm text-white/60 mt-1 font-body">
              Supplying industrial food processors, bakeries, snack brands, beverage formulators, and exporters.
            </p>
          </div>

          <form
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-4"
          >
            <!-- Web3Forms Config -->
            <input type="hidden" name="access_key" value={web3FormsKey} />
            <input type="hidden" name="subject" value="New B2B Sample & Quote Request - Renol Foods" />
            <input type="hidden" name="from_name" value="Renol Foods Website" />
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

            <!-- Single column on mobile (grid-cols-1), 2 cols on tablet/desktop (sm:grid-cols-2) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                  Full Name *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  autocomplete="name"
                  placeholder="e.g. Ramesh Shah"
                  class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white placeholder:text-white/30 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 min-h-[44px]"
                />
              </div>

              <div>
                <label for="company" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                  Company / Brand Name *
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  required
                  autocomplete="organization"
                  placeholder="e.g. Heritage Foods Ltd."
                  class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white placeholder:text-white/30 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 min-h-[44px]"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                  Business Email *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder="purchasing@company.com"
                  class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white placeholder:text-white/30 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 min-h-[44px]"
                />
              </div>

              <div>
                <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                  Phone / WhatsApp *
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  autocomplete="tel"
                  placeholder="+91 98765 43210"
                  class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white placeholder:text-white/30 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 min-h-[44px]"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="product" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                  Target Product *
                </label>
                <select
                  id="product"
                  name="product"
                  required
                  class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 min-h-[44px]"
                >
                  <option value="" class="bg-[#18181c] text-white">Select a powder...</option>
                  {siteConfig.products.map((p) => (
                    <option value={p.name} class="bg-[#18181c] text-white">{p.name}</option>
                  ))}
                  <option value="Multiple Powders" class="bg-[#18181c] text-white">Multiple Powders / Custom Premix</option>
                </select>
              </div>

              <div>
                <label for="inquiryType" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                  Request Type *
                </label>
                <select
                  id="inquiryType"
                  name="inquiryType"
                  required
                  class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 min-h-[44px]"
                >
                  <option value="Sample Request" class="bg-[#18181c] text-white">Product Sample (Evaluation)</option>
                  <option value="Commercial Quote" class="bg-[#18181c] text-white">Commercial Quote</option>
                  <option value="Both" class="bg-[#18181c] text-white">Sample & Pricing</option>
                  <option value="Export Inquiry" class="bg-[#18181c] text-white">Global Export Inquiry</option>
                </select>
              </div>
            </div>

            <div>
              <label for="message" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                Application & Expected Quantity
              </label>
              <textarea
                id="message"
                name="message"
                rows="3"
                placeholder="Specify your application (e.g. snack seasoning, instant beverage, bakery), required volume, target mesh size, or packaging format..."
                class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white placeholder:text-white/30 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400"
              ></textarea>
            </div>

            <button
              type="submit"
              class="btn-accent w-full text-base !py-3.5 shadow-lg mt-2 min-h-[48px]"
            >
              Request a Sample
            </button>

            <p class="text-[11px] text-center text-white/40 pt-1 font-body">
              Strictly B2B commercial supply. Contact details are used exclusively for official sample and quotation correspondence.
            </p>
          </form>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
