---
// Internal component kit. noindex, excluded from the sitemap and disallowed in robots.txt.
// Remove before launch (final phase).
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Button from "../components/ui/Button.astro";
import Tag from "../components/ui/Tag.astro";
import Stat from "../components/ui/Stat.astro";
import Accordion from "../components/ui/Accordion.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import { products, productTheme } from "../data/products";
import { categoryById } from "../data/categories";
import { site } from "../data/site";

const swatches = [
  ["bg", "var(--bg)"],
  ["panel", "var(--panel)"],
  ["surface", "var(--surface)"],
  ["accent", "var(--accent)"],
];
---

<BaseLayout
  title="Component kit"
  description="Internal component kit for the Renol Foods site."
  noindex
>
  <h1
    class="container"
    style="font-size: var(--fs-h1); padding-top: var(--s-12);"
  >
    Component kit
  </h1>
  <Section
    id="kit-intro"
    eyebrow="Internal"
    title="Overview"
    lede="Every shared component in one place. Not linked from the site."
  >
    <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Kit" }]} />
  </Section>

  <Section id="kit-colour" title="Colour and type" tone="panel">
    <ul class="swatches">
      {
        swatches.map(([name, value]) => (
          <li>
            <span class="swatch" style={`background:${value}`} />
            {name}
          </li>
        ))
      }
    </ul>
    <p
      style="font-size: var(--fs-display); font-family: var(--display); font-weight: 800; line-height: 1;"
    >
      Display
    </p>
    <h3>Heading three</h3>
    <p>
      Body copy in Instrument Sans at the fluid body size. The secondary tone is
      used for supporting text.
    </p>
    <p style="color: var(--ink-3)">Tertiary text, the lowest allowed tone.</p>
  </Section>

  <Section id="kit-buttons" title="Buttons and tags">
    <div class="row">
      <Button href="/products" size="lg">View More Products</Button>
      <Button variant="ghost" href="/products">View More Products</Button>
      <Button variant="link" href="/contact">Contact</Button>
      <Button type="button" variant="ghost">Button element</Button>
    </div>
    <div class="row">
      {
        products
          .slice(0, 8)
          .map((p) => <Tag accent={productTheme(p).accent}>{p.name}</Tag>)
      }
    </div>
  </Section>

  <Section id="kit-cards" title="Cards and stats" tone="panel">
    <div class="grid">
      {
        products.slice(0, 3).map((p) => (
          <Card
            title={p.name}
            eyebrow={categoryById(p.category).name}
            accent={productTheme(p).accent}
            href={`/products/${p.slug}`}
          >
            <p>{p.summary}</p>
          </Card>
        ))
      }
    </div>
    <div class="row stats">
      <Stat value={String(site.foundedYear)} label="Founded" />
      <Stat value={String(products.length)} label="Powders" />
    </div>
  </Section>

  <Section id="kit-faq" title="Accordion" tone="panel">
    <Accordion
      name="kit"
      items={[
        {
          question: "Where are you based?",
          answer: `${site.address.street}, ${site.address.city}, ${site.address.state}.`,
        },
        {
          question: "Which powders do you make?",
          answer:
            products
              .slice(0, 8)
              .map((p) => p.name)
              .join(", ") + " and more.",
        },
      ]}
    />
  </Section>
</BaseLayout>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
    margin-block: var(--s-6);
  }
  .grid {
    display: grid;
    gap: var(--s-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    margin-bottom: var(--s-6);
  }
  .stats {
    gap: var(--s-12);
  }
  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin: 0 0 var(--s-6);
    padding: 0;
    list-style: none;
    color: var(--ink-2);
  }
  .swatch {
    display: block;
    inline-size: 4rem;
    block-size: 4rem;
    margin-bottom: var(--s-2);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
  }
</style>
