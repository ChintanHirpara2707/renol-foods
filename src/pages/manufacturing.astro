---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { manufacturingProcess } from "../data/process";
---

<BaseLayout
  title="Manufacturing Process & Facility | Renol Foods Bavla"
  description="Explore Renol Foods' dehydration and spray drying manufacturing process in Bavla, Ahmedabad: raw material sourcing, washing, extraction, atomization, testing, and protective packing."
>
  <!-- Hero Section -->
  <section class="relative py-20 lg:py-28 border-b border-white/10 overflow-hidden">
    <!-- Ambient Radial Glow -->
    <div
      class="pointer-events-none absolute left-1/2 top-10 -translate-x-1/2 w-[700px] h-[350px] rounded-full blur-[140px] opacity-20"
      style="background: radial-gradient(circle, #4ade80 0%, transparent 70%);"
      aria-hidden="true"
    ></div>

    <div class="section-container relative z-10">
      <SectionHeading
        eyebrow="Processing Infrastructure"
        title="Industrial Dehydration & Spray Drying"
        subtitle="General production stages engineered in Bavla for high-solids fruit juices, botanical leaves, and savory culinary purees."
      />

      <!-- Hero Primary Action Button (1 per hero) -->
      <div class="mt-8 flex justify-center">
        <a href="/contact#sample-quote" class="btn-accent min-h-[44px]">
          Request a Sample
        </a>
      </div>

      <!-- 6-Stage Timeline Grid: 3 cols on desktop, 2 on tablet, 1 on mobile -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          manufacturingProcess.map((step) => (
            <div class="group relative p-8 rounded-3xl bg-[#121214] border border-white/10 hover:border-white/25 transition-all duration-300 flex flex-col justify-between overflow-hidden">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="inline-block px-3 py-1 rounded-full bg-white/10 text-white/80 text-xs font-semibold uppercase tracking-wider font-mono">
                    Stage 0{step.stepNumber}
                  </span>
                  <span class="font-display text-4xl font-black text-white/10 group-hover:text-white/20 transition-colors">
                    0{step.stepNumber}
                  </span>
                </div>

                <h3 class="font-display text-2xl font-bold text-white mb-1">
                  {step.title}
                </h3>
                <p class="text-xs font-semibold uppercase tracking-wider mb-3 text-amber-400 font-mono">
                  {step.subtitle}
                </p>
                <p class="text-sm text-white/70 leading-relaxed font-body">
                  {step.description}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-white/10 text-xs text-white/50 font-body">
                <strong class="text-white/80">Key Control Point:</strong> {step.keyControlPoint}
              </div>
            </div>
          ))
        }
      </div>

      <!-- Process Parameter Summary Table in responsive container -->
      <div class="mt-16 bg-[#121214] border border-white/10 rounded-3xl p-6 sm:p-8">
        <div class="mb-6">
          <h3 class="font-display text-xl sm:text-2xl font-bold text-white">
            Standard Processing Parameters & Controls
          </h3>
          <p class="text-sm text-white/70 mt-1">
            General operating benchmarks maintained across industrial drying runs in Bavla.
          </p>
        </div>

        <div class="table-responsive">
          <table class="w-full text-left text-sm text-white/80 min-w-[560px]">
            <thead class="border-b border-white/10 text-xs uppercase text-white/50 font-mono bg-white/5">
              <tr>
                <th scope="col" class="py-3 px-4">Processing Stage</th>
                <th scope="col" class="py-3 px-4">Monitored Parameter</th>
                <th scope="col" class="py-3 px-4">Target Standard</th>
                <th scope="col" class="py-3 px-4">Equipment Framework</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5 font-body">
              <tr>
                <td class="py-3.5 px-4 font-medium text-white">Raw Material Sorting</td>
                <td class="py-3.5 px-4 text-white/70">Maturity, dry solids, brix</td>
                <td class="py-3.5 px-4 font-mono text-xs text-amber-300">Grade A Produce</td>
                <td class="py-3.5 px-4 text-white/60">Inspection conveyors</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-medium text-white">Fluid Atomization</td>
                <td class="py-3.5 px-4 text-white/70">Feed viscosity & spray droplet size</td>
                <td class="py-3.5 px-4 font-mono text-xs text-amber-300">Uniform droplet spray</td>
                <td class="py-3.5 px-4 text-white/60">High-speed rotary atomizer</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-medium text-white">Moisture Evaporation</td>
                <td class="py-3.5 px-4 text-white/70">Inlet / outlet drying air temperature</td>
                <td class="py-3.5 px-4 font-mono text-xs text-amber-300">Rapid moisture flash</td>
                <td class="py-3.5 px-4 text-white/60">Co-current drying tower</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-medium text-white">Powder Recovery & Sifting</td>
                <td class="py-3.5 px-4 text-white/70">Mesh sizing & particle uniformity</td>
                <td class="py-3.5 px-4 font-mono text-xs text-amber-300">40 to 120 mesh</td>
                <td class="py-3.5 px-4 text-white/60">Cyclone separators & vibro sifters</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-medium text-white">Protective Packaging</td>
                <td class="py-3.5 px-4 text-white/70">Bag sealing integrity & moisture barrier</td>
                <td class="py-3.5 px-4 font-mono text-xs text-amber-300">Airtight LDPE lining</td>
                <td class="py-3.5 px-4 text-white/60">Industrial heat sealers & scales</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </section>

  <!-- One Closing CTA Section Near the End of the Page -->
  <section class="py-20 bg-[#0e0e12] text-white text-center border-t border-white/10">
    <div class="section-container max-w-3xl">
      <span class="text-xs uppercase font-bold tracking-widest text-white/40 block mb-3 font-mono">Plant Audits & Inquiries</span>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold mb-4 tracking-tight">
        Planning an audit or need custom processing parameters?
      </h2>
      <p class="text-white/70 text-sm sm:text-base mb-8 max-w-xl mx-auto leading-relaxed font-body">
        Technical representatives from commercial food manufacturers are welcome to schedule plant reviews in Bavla.
      </p>
      <a href="/contact#sample-quote" class="btn-accent min-h-[44px]">
        Request a Sample
      </a>
    </div>
  </section>
</BaseLayout>
