---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import Button from "../../components/ui/Button.astro";
import Tag from "../../components/ui/Tag.astro";
import ChatLink from "../../components/ChatLink.astro";
import LicenceBadges from "../../components/LicenceBadges.astro";
import { products, publicSpecs, productTheme, type Product } from "../../data/products";
import { categoryById } from "../../data/categories";
import { productChatMessage, site } from "../../data/site";
import { CTA } from "../../data/cta";

export async function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: {
      product,
      related: products.filter((p) => p.category === product.category && p.slug !== product.slug).slice(0, 4),
    },
  }));
}

interface Props {
  product: Product;
  related: Product[];
}

const { product, related } = Astro.props;
const theme = productTheme(product);
const category = categoryById(product.category);
const specs = publicSpecs(product);
const chatMessage = productChatMessage(product);
const origin = Astro.site ?? new URL(Astro.url.origin);

const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: product.name,
  description: product.description,
  image: new URL(product.image, origin).href,
  category: category.name,
  brand: { "@type": "Brand", name: site.name },
  manufacturer: {
    "@type": "Organization",
    name: site.name,
    address: {
      "@type": "PostalAddress",
      streetAddress: site.address.street,
      addressLocality: site.address.city,
      addressRegion: site.address.state,
      addressCountry: site.address.countryCode,
    },
  },
};
---

<BaseLayout
  title={`${product.name} | ${site.name}`}
  description={product.summary}
  ogImage={product.image}
  jsonLd={[productSchema]}
  chatMessage={chatMessage}
>
  <article class="product" style={`--accent: ${theme.accent}; --glow: ${theme.glow};`}>
    <div class="container">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          { label: "Products", href: "/products" },
          { label: product.name },
        ]}
      />

      <div class="product__grid">
        <div class="product__media">
          <img src={product.image} alt={product.name} width="800" height="800" decoding="async" fetchpriority="high" />
        </div>

        <div class="product__body">
          <Tag accent={theme.accent}>{category.name}</Tag>
          <h1>{product.name}</h1>
          <p class="product__summary">{product.summary}</p>
          <p class="product__description">{product.description}</p>

          <div class="product__actions">
            <ChatLink class="btn-wa" message={chatMessage} />
            <Button href={CTA.products.href} variant="ghost">{CTA.products.label}</Button>
          </div>

          <div class="product__licences">
            <LicenceBadges />
          </div>
        </div>
      </div>

      <div class="product__facts">
        {
          product.uses.length > 0 && (
            <section aria-labelledby="uses-title">
              <h2 id="uses-title">Typical uses</h2>
              <ul class="tags">
                {product.uses.map((use) => <li>{use}</li>)}
              </ul>
            </section>
          )
        }

        <section aria-labelledby="pack-title">
          <h2 id="pack-title">Packaging</h2>
          <p class="pack">{product.packaging}</p>
          {product.allergens.length > 0 && <p class="allergens">Contains: {product.allergens.join(", ")}.</p>}
        </section>

        <section aria-labelledby="specs-title">
          <h2 id="specs-title">Specifications</h2>
          {
            specs.length > 1 ? (
              <dl class="specs">
                {specs.map((s) => (
                  <>
                    <dt>{s.label}</dt>
                    <dd>{s.value}</dd>
                  </>
                ))}
              </dl>
            ) : (
              <p class="muted">Full specifications on request</p>
            )
          }
        </section>
      </div>

      {
        related.length > 0 && (
          <section class="related" aria-labelledby="related-title">
            <h2 id="related-title">More {category.name.toLowerCase()}</h2>
            <ul>
              {related.map((p) => (
                <li>
                  <a href={`/products/${p.slug}`}>{p.name}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .product {
    padding-block: var(--s-6) var(--section-y);
    background: radial-gradient(60% 40% at 80% 0%, color-mix(in srgb, var(--glow) 45%, transparent), transparent), var(--bg);
  }
  .product__grid {
    display: grid;
    gap: var(--s-8);
    margin-top: var(--s-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .product__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: center;
      gap: var(--s-16);
    }
  }
  .product__media img {
    display: block;
    width: 100%;
    max-width: 34rem;
    height: auto;
    margin-inline: auto;
    border-radius: var(--r-panel);
    border: 1px solid var(--line-soft);
    aspect-ratio: 1;
    object-fit: cover;
  }
  .product__body h1 {
    margin-top: var(--s-4);
    font-size: var(--fs-h1);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .product__summary {
    margin-top: var(--s-4);
    color: var(--ink);
    font-size: 1.125rem;
  }
  .product__description {
    margin-top: var(--s-3);
    max-width: var(--prose);
    color: var(--ink-2);
  }
  .product__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
  }
  .product__licences {
    margin-top: var(--s-6);
  }
  .product__facts {
    display: grid;
    gap: var(--s-8);
    margin-top: var(--s-16);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .product__facts h2,
  .related h2 {
    margin-bottom: var(--s-3);
    font-size: var(--fs-h3);
    font-weight: 800;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.4rem 0.9rem;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--accent) 20%, transparent);
    font-size: var(--fs-small);
  }
  .pack {
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 500;
  }
  .allergens,
  .muted {
    margin-top: var(--s-2);
    color: var(--ink-2);
  }
  .specs {
    display: grid;
    grid-template-columns: 9rem 1fr;
    margin: 0;
  }
  .specs dt,
  .specs dd {
    margin: 0;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
  }
  .specs dt {
    color: var(--ink-2);
  }
  .related {
    margin-top: var(--s-16);
  }
  .related ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .related a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    color: var(--ink);
  }
  .related a:hover {
    border-color: var(--accent);
  }
</style>
