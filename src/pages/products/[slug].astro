---
import { existsSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import Button from "../../components/ui/Button.astro";
import Tag from "../../components/ui/Tag.astro";
import ChatLink from "../../components/ChatLink.astro";
import LicenceBadges from "../../components/LicenceBadges.astro";
import { products, publicSpecs, productTheme, type Product } from "../../data/products";
import { categoryById } from "../../data/categories";
import { productChatMessage, site, DEMO, demoLink } from "../../data/site";
import { CTA } from "../../data/cta";

export async function getStaticPaths() {
  return products.map((product, i) => ({
    params: { slug: product.slug },
    props: {
      product,
      related: products.filter((p) => p.category === product.category && p.slug !== product.slug).slice(0, 4),
      prev: products[(i - 1 + products.length) % products.length],
      next: products[(i + 1) % products.length],
    },
  }));
}

interface Props {
  product: Product;
  related: Product[];
  prev: Product;
  next: Product;
}

const { product, related, prev, next } = Astro.props;
const theme = productTheme(product);
const category = categoryById(product.category);
const specs = publicSpecs(product);
const chatMessage = productChatMessage(product);
const origin = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(`/products/${product.slug}/`, origin).href;

// Studio products show the fruit as rendered in the Powder Studio (still); others use the product image.
const art = product.slug.replace(/-powder$/, "");
const posterFile = `/images/fruit/${art}.webp`;
const poster = product.studio && existsSync(join(process.cwd(), "public", posterFile)) ? posterFile : null;

// Carton label: product name wrapped to short lines
const labelLines: string[] = [];
for (const word of product.name.split(" ")) {
  const last = labelLines[labelLines.length - 1];
  if (last && (last + " " + word).length <= 14) labelLines[labelLines.length - 1] = `${last} ${word}`;
  else labelLines.push(word);
}
const labelSize = labelLines.length > 2 ? 12 : 14;
const labelTop = 150 - ((labelLines.length - 1) * labelSize * 1.2) / 2;

const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: product.name,
  description: product.description,
  image: new URL(poster ?? product.image, origin).href,
  category: category.name,
  url: pageUrl,
  brand: { "@type": "Brand", name: site.name },
  manufacturer: {
    "@type": "Organization",
    name: site.name,
    address: {
      "@type": "PostalAddress",
      streetAddress: site.address.street,
      addressLocality: site.address.city,
      addressRegion: site.address.state,
      addressCountry: site.address.countryCode,
    },
  },
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", origin).href },
    { "@type": "ListItem", position: 2, name: "Products", item: new URL("/products/", origin).href },
    { "@type": "ListItem", position: 3, name: product.name, item: pageUrl },
  ],
};
---

<BaseLayout
  title={`${product.name} | ${category.name} | ${site.name}`}
  description={`${product.summary} ${product.packaging}.`}
  ogImage={poster ?? product.image}
  jsonLd={[productSchema, breadcrumbSchema]}
  chatMessage={chatMessage}
>
  <article class="product" style={`--accent: ${theme.accent}; --glow: ${theme.glow};`}>
    <div class="container">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          { label: "Products", href: "/products" },
          { label: product.name },
        ]}
      />

      <div class="product__grid">
        <div class:list={["product__media", { "product__media--studio": Boolean(poster) }]}>
          {
            poster ? (
              <img src={poster} alt={product.name} width="400" height="480" decoding="async" fetchpriority="high" />
            ) : (
              <img src={product.image} alt={product.name} width="800" height="800" decoding="async" fetchpriority="high" />
            )
          }
        </div>

        <div class="product__body">
          <Tag accent={theme.accent}>{category.name}</Tag>
          <h1>{product.name}</h1>
          <p class="product__summary">{product.summary}</p>
          <p class="product__description">{product.description}</p>

          <div class="product__actions">
            <Button href={demoLink(product.slug)}>{DEMO.label}</Button>
            <ChatLink class="btn-wa" message={chatMessage} />
            <Button href={CTA.products.href} variant="ghost">{CTA.products.label}</Button>
          </div>

          <div class="product__licences">
            <LicenceBadges />
          </div>
        </div>
      </div>

      <div class="product__facts">
        {
          product.uses.length > 0 && (
            <section aria-labelledby="uses-title">
              <h2 id="uses-title">Typical uses</h2>
              <ul class="tags">
                {product.uses.map((use) => <li>{use}</li>)}
              </ul>
            </section>
          )
        }

        <section class="packaging" aria-labelledby="pack-title">
          <h2 id="pack-title">Packaging</h2>
          <div class="packaging__row">
            <svg class="carton" viewBox="0 0 320 250" role="img" aria-label={`${product.name} in a ${product.packaging}`}>
              <polygon points="64,86 104,62 296,62 256,86" fill="#d6a566" />
              <polygon points="256,86 296,62 296,182 256,214" fill="#8f6531" />
              <rect x="64" y="86" width="192" height="128" fill="#b98a52" />
              <rect x="150" y="62" width="20" height="24" fill="#e9d3a8" fill-opacity=".75" />
              <path d="M64 100H256M64 114H256M64 128H256M64 142H256M64 156H256M64 170H256M64 184H256M64 198H256" stroke="#7a5528" stroke-opacity=".18" />
              <rect x="86" y="108" width="148" height="84" rx="6" fill="#fff" fill-opacity=".95" />
              <text x="160" y="124" text-anchor="middle" font-size="10" fill="#6b5a45" style="font-family:var(--body);letter-spacing:.08em">{site.name.toUpperCase()}</text>
              {
                labelLines.map((line, i) => (
                  <text x="160" y={labelTop + 8 + i * labelSize * 1.2} text-anchor="middle" font-size={labelSize} font-weight="800" fill="#17120b" style="font-family:var(--display)">
                    {line}
                  </text>
                ))
              }
              <text x="160" y="184" text-anchor="middle" font-size="11" fill="#17120b" fill-opacity=".7" style="font-family:var(--body)">{product.packaging}</text>
            </svg>
            <div>
              <p class="pack">{product.packaging}</p>
              {product.allergens.length > 0 && <p class="allergens">Contains: {product.allergens.join(", ")}.</p>}
            </div>
          </div>
        </section>

        <section aria-labelledby="specs-title">
          <h2 id="specs-title">Specifications</h2>
          {
            specs.length > 1 ? (
              <dl class="specs">
                {specs.map((s) => (
                  <>
                    <dt>{s.label}</dt>
                    <dd>{s.value}</dd>
                  </>
                ))}
              </dl>
            ) : (
              <p class="muted">Full specifications on request</p>
            )
          }
        </section>
      </div>

      {
        related.length > 0 && (
          <section class="related" aria-labelledby="related-title">
            <h2 id="related-title">More {category.name.toLowerCase()}</h2>
            <ul>
              {related.map((p) => (
                <li>
                  <a href={`/products/${p.slug}`}>
                    <img src={p.image} alt="" width="800" height="800" loading="lazy" decoding="async" />
                    <span>{p.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <nav class="pn" aria-label="Previous and next product">
        <a href={`/products/${prev.slug}`} rel="prev"><span aria-hidden="true">&larr;</span> {prev.name}</a>
        <a href={`/products/${next.slug}`} rel="next">{next.name} <span aria-hidden="true">&rarr;</span></a>
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .product {
    padding-block: var(--s-6) var(--section-y);
    background: radial-gradient(60% 40% at 80% 0%, color-mix(in srgb, var(--glow) 45%, transparent), transparent), var(--bg);
  }
  .product__grid {
    display: grid;
    gap: var(--s-8);
    margin-top: var(--s-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .product__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: center;
      gap: var(--s-16);
    }
  }
  .product__media img {
    display: block;
    width: 100%;
    max-width: 34rem;
    height: auto;
    margin-inline: auto;
    border: 1px solid var(--line-soft);
    border-radius: var(--r-panel);
    aspect-ratio: 1;
    object-fit: cover;
  }
  /* Studio products: the rendered fruit on the product's glow */
  .product__media--studio img {
    padding: var(--s-6);
    border-color: transparent;
    background: radial-gradient(62% 58% at 50% 44%, color-mix(in srgb, var(--glow) 80%, transparent), transparent), var(--panel);
    object-fit: contain;
    filter: drop-shadow(0 28px 36px rgba(0, 0, 0, 0.45));
  }
  .product__body h1 {
    margin-top: var(--s-4);
    font-size: var(--fs-h1);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .product__summary {
    margin-top: var(--s-4);
    font-size: 1.125rem;
  }
  .product__description {
    margin-top: var(--s-3);
    max-width: var(--prose);
    color: var(--ink-2);
  }
  .product__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
  }
  .product__licences {
    margin-top: var(--s-6);
  }
  .product__facts {
    display: grid;
    gap: var(--s-8);
    margin-top: var(--s-16);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .product__facts h2,
  .related h2 {
    margin-bottom: var(--s-3);
    font-size: var(--fs-h3);
    font-weight: 800;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.4rem 0.9rem;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--accent) 20%, transparent);
    font-size: var(--fs-small);
  }
  .packaging__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
  }
  .carton {
    width: min(100%, 15rem);
    height: auto;
    filter: drop-shadow(0 16px 20px rgba(0, 0, 0, 0.4));
  }
  .pack {
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 500;
  }
  .allergens,
  .muted {
    margin-top: var(--s-2);
    color: var(--ink-2);
  }
  .specs {
    display: grid;
    grid-template-columns: 9rem 1fr;
    margin: 0;
  }
  .specs dt,
  .specs dd {
    margin: 0;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
  }
  .specs dt {
    color: var(--ink-2);
  }
  .related {
    margin-top: var(--s-16);
  }
  .related ul {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 768px) {
    .related ul {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .related a {
    display: block;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    border-radius: var(--r-card);
    background: var(--surface);
  }
  .related a:hover {
    border-color: var(--accent);
  }
  .related img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .related span {
    display: block;
    padding: var(--s-3) var(--s-4);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .pn {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: var(--s-16);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .pn a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    color: var(--ink-2);
  }
  .pn a:hover {
    color: var(--ink);
  }
</style>
