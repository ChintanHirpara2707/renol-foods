---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChatLink from "../components/ChatLink.astro";
import SectionHeading from "../components/SectionHeading.astro";
---

<BaseLayout
  title="Private Label & Custom Formulations | Renol Foods Bavla"
  description="Contract manufacturing, custom spray drying, carrier blending, proprietary mesh milling, and private label packaging for commercial food brands."
>
  <!-- Hero Section -->
  <section class="relative py-20 lg:py-28 border-b border-white/10 overflow-hidden">
    <!-- Ambient Radial Glow -->
    <div
      class="pointer-events-none absolute left-1/2 top-10 -translate-x-1/2 w-[700px] h-[350px] rounded-full blur-[140px] opacity-20"
      style="background: radial-gradient(circle, #ea580c 0%, transparent 70%);"
      aria-hidden="true"
    ></div>

    <div class="section-container relative z-10">
      <SectionHeading
        level={1}
        eyebrow="Contract Manufacturing"
        title="Private Label & Custom Formulations"
        subtitle="Tailored and spray drying solutions engineered to client recipes, proprietary mesh specifications, and branded packaging requirements."
      />

      <!-- Hero Primary Action Button (1 per hero) -->
      <div class="mt-8 flex justify-center">
        <ChatLink class="btn-accent min-h-[44px]" />
      </div>

      <!-- Core Capabilities Grid: 3 cols desktop, 2 tablet, 1 mobile -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="p-8 rounded-3xl bg-[#121214] border border-white/10 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-amber-400 font-display font-bold text-lg mb-4">
              01
            </div>
            <h2 class="font-display text-2xl font-bold text-white mb-2">
              Custom Carrier Balancing
            </h2>
            <p class="text-sm text-white/70 leading-relaxed font-body">
              Calibrating natural fruit solids with maltodextrin or gum acacia carriers to optimize hygroscopicity, solubility index, and flow behavior for your manufacturing equipment.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-white/10 text-xs text-amber-400 font-mono">
            Optimized for automatic powder dosers
          </div>
        </div>

        <div class="p-8 rounded-3xl bg-[#121214] border border-white/10 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-amber-400 font-display font-bold text-lg mb-4">
              02
            </div>
            <h2 class="font-display text-2xl font-bold text-white mb-2">
              Proprietary Particle Mesh Sizing
            </h2>
            <p class="text-sm text-white/70 leading-relaxed font-body">
              Controlled sifting from coarse topical seasoning granules (40–60 mesh) ensuring snack surface adhesion to ultra-fine micro-milled powders (80–120 mesh) for cold instant dissolution.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-white/10 text-xs text-amber-400 font-mono">
            Mesh grading from 40 to 120 mesh
          </div>
        </div>

        <div class="p-8 rounded-3xl bg-[#121214] border border-white/10 flex flex-col justify-between md:col-span-2 lg:col-span-1">
          <div>
            <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-amber-400 font-display font-bold text-lg mb-4">
              03
            </div>
            <h2 class="font-display text-2xl font-bold text-white mb-2">
              B2B Private Label Packaging
            </h2>
            <p class="text-sm text-white/70 leading-relaxed font-body">
              Direct filling into client-specified packaging formats: nitrogen-flushed foil pouches, 20 kg/25 kg multi-wall craft bags with poly liners, or heavy-duty fiber drums with custom barcode labeling.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-white/10 text-xs text-amber-400 font-mono">
            Pouches, kraft bags & bulk drums
          </div>
        </div>
      </div>

      <!-- Confidentiality & NDA Card -->
      <div class="mt-14 p-8 sm:p-10 rounded-3xl bg-[#121214] border border-white/10 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center md:text-left">
          <span class="text-xs uppercase font-mono tracking-wider text-amber-400 block">Strict Client Confidentiality</span>
          <h2 class="font-display text-xl sm:text-2xl font-bold text-white">
            Proprietary Recipe Protection under Mutual NDA
          </h2>
          <p class="text-sm text-white/70 max-w-2xl font-body">
            We partner with FMCG brands, QSR suppliers, and seasoning blenders under strict non-disclosure agreements to safeguard your proprietary formulation recipes and blend ratios.
          </p>
        </div>
        <div class="shrink-0">
          <ChatLink class="btn-secondary min-h-[44px]" />
        </div>
      </div>

    </div>
  </section>

  <!-- One Closing CTA Section Near the End of the Page -->
  <section class="py-20 bg-[#0e0e12] text-white text-center border-t border-white/10">
    <div class="section-container max-w-3xl">
      <span class="text-xs uppercase font-bold tracking-widest text-white/60 block mb-3 font-mono">Custom Projects</span>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold mb-4 tracking-tight">
        Have a proprietary powder specification to develop?
      </h2>
      <p class="text-white/70 text-sm sm:text-base mb-8 max-w-xl mx-auto leading-relaxed font-body">
        Discuss your batch size requirements, carrier preferences, and packaging specifications with our manufacturing desk.
      </p>
      <ChatLink class="btn-accent min-h-[44px]" />
    </div>
  </section>
</BaseLayout>
