---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { products } from "../data/products";

const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || "";
---

<BaseLayout
  title="Request Commercial Quote & Samples | Renol Foods Bavla"
  description="Request bulk commercial pricing, technical parameters, and evaluation trial samples for industrial food powders manufactured in Bavla, Ahmedabad."
>
  <!-- Hero Section -->
  <section class="relative py-16 lg:py-24 border-b border-white/10 overflow-hidden font-body">
    <!-- Ambient Radial Glow -->
    <div
      class="pointer-events-none absolute left-1/2 top-10 -translate-x-1/2 w-[700px] h-[350px] rounded-full blur-[140px] opacity-20"
      style="background: radial-gradient(circle, #f59e0b 0%, transparent 70%);"
      aria-hidden="true"
    ></div>

    <div class="section-container relative z-10">
      <SectionHeading
        eyebrow="B2B Commercial Inquiries"
        title="Request a Commercial Quote"
        subtitle="Submit your target powder specifications, required volume, and application details. Our sales desk in Bavla will prepare a formal price indication and sample dispatch plan."
      />

      <!-- Hero Primary Action Button (1 per hero) -->
      <div class="mt-8 flex justify-center">
        <a href="#quote-form-section" class="btn-accent min-h-[44px]">
          Request a Sample
        </a>
      </div>

      <!-- Multi-segment Form Container: Single column on mobile, fits without side scrolling (Rule 8) -->
      <div id="quote-form-section" class="mt-14 max-w-4xl mx-auto bg-[#121214] border border-white/10 rounded-3xl p-6 sm:p-10 shadow-2xl scroll-mt-24">
        
        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-8"
        >
          <!-- Web3Forms Config -->
          <input type="hidden" name="access_key" value={web3FormsKey} />
          <input type="hidden" name="subject" value="New Commercial Quote & Sample Request - Renol Foods" />
          <input type="hidden" name="from_name" value="Renol Foods Quote Desk" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <!-- Segment 1: Product Selection & Sizing -->
          <div class="space-y-4">
            <div class="flex items-center gap-3 pb-2 border-b border-white/10">
              <span class="w-6 h-6 rounded-full bg-amber-400 text-[#140a00] font-bold text-xs flex items-center justify-center shrink-0">1</span>
              <h3 class="font-display text-lg sm:text-xl font-bold text-white tracking-tight">
                Product & Application Specifications
              </h3>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <div>
                <label for="q-product" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                  Target Product *
                </label>
                <select
                  id="q-product"
                  name="product"
                  required
                  class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 min-h-[44px]"
                >
                  <option value="" class="bg-[#18181c] text-white">Select food powder...</option>
                  {products.map((p) => (
                    <option value={p.name} class="bg-[#18181c] text-white">{p.name} ({p.cat} powder)</option>
                  ))}
                  <option value="Custom Blend" class="bg-[#18181c] text-white">Custom Formulation / Private Label</option>
                </select>
              </div>

              <div>
                <label for="q-mesh" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                  Particle Mesh Requirement
                </label>
                <select
                  id="q-mesh"
                  name="mesh"
                  class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 min-h-[44px]"
                >
                  <option value="Standard Specification" class="bg-[#18181c] text-white">Standard Factory Specification</option>
                  <option value="Coarse Topical (40-60 mesh)" class="bg-[#18181c] text-white">Coarse Snack Dusting (40–60 mesh)</option>
                  <option value="Standard Fine (60-80 mesh)" class="bg-[#18181c] text-white">Standard Bakery / Premix (60–80 mesh)</option>
                  <option value="Micro-milled (80-120 mesh)" class="bg-[#18181c] text-white">Micro-milled Cold Soluble (80–120 mesh)</option>
                </select>
              </div>
            </div>

            <div>
              <label for="q-application" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                Primary End Application *
              </label>
              <input
                type="text"
                id="q-application"
                name="application"
                required
                placeholder="e.g. Extruded snack topical dusting, instant soup mix, biscuit flavoring"
                class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white placeholder:text-white/30 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 min-h-[44px]"
              />
            </div>
          </div>

          <!-- Segment 2: Volume & Logistics -->
          <div class="space-y-4">
            <div class="flex items-center gap-3 pb-2 border-b border-white/10">
              <span class="w-6 h-6 rounded-full bg-amber-400 text-[#140a00] font-bold text-xs flex items-center justify-center shrink-0">2</span>
              <h3 class="font-display text-lg sm:text-xl font-bold text-white tracking-tight">
                Volume & Packaging Requirements
              </h3>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <div>
                <label for="q-volume" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                  Estimated Batch Quantity *
                </label>
                <select
                  id="q-volume"
                  name="estimatedVolume"
                  required
                  class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 min-h-[44px]"
                >
                  <option value="" class="bg-[#18181c] text-white">Select expected volume...</option>
                  <option value="Sample Packet (200g - 1kg)" class="bg-[#18181c] text-white">Evaluation Trial Sample (200 g – 1 kg)</option>
                  <option value="Pilot Batch (100kg - 500kg)" class="bg-[#18181c] text-white">Trial Production Batch (100 kg – 500 kg)</option>
                  <option value="Commercial Run (1 - 5 MT)" class="bg-[#18181c] text-white">Commercial Production (1 MT – 5 MT)</option>
                  <option value="Container Load (10 MT+)" class="bg-[#18181c] text-white">Container Load FCL (10 MT+)</option>
                </select>
              </div>

              <div>
                <label for="q-packaging" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                  Preferred Packaging Format
                </label>
                <select
                  id="q-packaging"
                  name="packagingPreference"
                  class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 min-h-[44px]"
                >
                  <option value="20kg / 25kg Kraft Bags" class="bg-[#18181c] text-white">Standard Multi-wall Kraft Bags (20/25 kg)</option>
                  <option value="Poly-lined Fiber Drums" class="bg-[#18181c] text-white">Heavy-duty Poly-lined Fiber Drums</option>
                  <option value="Custom Private Label Pouches" class="bg-[#18181c] text-white">Custom Printed Foil Pouches</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Segment 3: Company & Contact Information -->
          <div class="space-y-4">
            <div class="flex items-center gap-3 pb-2 border-b border-white/10">
              <span class="w-6 h-6 rounded-full bg-amber-400 text-[#140a00] font-bold text-xs flex items-center justify-center shrink-0">3</span>
              <h3 class="font-display text-lg sm:text-xl font-bold text-white tracking-tight">
                Company & Contact Verification
              </h3>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <div>
                <label for="q-name" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                  Your Full Name *
                </label>
                <input
                  type="text"
                  id="q-name"
                  name="name"
                  required
                  autocomplete="name"
                  placeholder="Full name"
                  class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white placeholder:text-white/30 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 min-h-[44px]"
                />
              </div>

              <div>
                <label for="q-company" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                  Company / Organization *
                </label>
                <input
                  type="text"
                  id="q-company"
                  name="company"
                  required
                  autocomplete="organization"
                  placeholder="Company name"
                  class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white placeholder:text-white/30 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 min-h-[44px]"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="q-email" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                  Business Email *
                </label>
                <input
                  type="email"
                  id="q-email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder="procurement@company.com"
                  class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white placeholder:text-white/30 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 min-h-[44px]"
                />
              </div>

              <div>
                <label for="q-phone" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                  Phone / WhatsApp *
                </label>
                <input
                  type="tel"
                  id="q-phone"
                  name="phone"
                  required
                  autocomplete="tel"
                  placeholder="+91 98765 43210"
                  class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white placeholder:text-white/30 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 min-h-[44px]"
                />
              </div>
            </div>

            <div>
              <label for="q-destination" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-1.5 font-mono">
                Delivery Location (City / Country / Destination Port)
              </label>
              <input
                type="text"
                id="q-destination"
                name="destination"
                placeholder="e.g. Mumbai, India or FOB Mundra / CIF Dubai"
                class="w-full px-4 py-3 rounded-xl bg-[#18181c] border border-white/15 text-sm text-white placeholder:text-white/30 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 min-h-[44px]"
              />
            </div>
          </div>

          <button
            type="submit"
            class="btn-accent w-full text-base !py-4 shadow-xl min-h-[48px] rounded-full font-bold"
          >
            Submit Commercial Quote Request
          </button>

          <p class="text-xs text-center text-white/40 pt-1 font-body">
            Strictly B2B commercial supply. Price indications and sample dispatches are subject to manufacturing review.
          </p>
        </form>

      </div>
    </div>
  </section>

  <!-- One Closing CTA Section Near the End of the Page -->
  <section class="py-20 bg-[#0e0e12] text-white text-center border-t border-white/10">
    <div class="section-container max-w-3xl">
      <span class="text-xs uppercase font-bold tracking-widest text-white/40 block mb-3 font-mono">Factory Support</span>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold mb-4 tracking-tight">
        Prefer direct coordination with sales engineers?
      </h2>
      <p class="text-white/70 text-sm sm:text-base mb-8 max-w-xl mx-auto leading-relaxed font-body">
        Our commercial desk in Bavla, Ahmedabad is available Monday to Saturday for direct phone and email correspondence.
      </p>
      <a href="/contact#sample-quote" class="btn-accent min-h-[44px]">
        Request a Sample
      </a>
    </div>
  </section>
</BaseLayout>
