---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
---

<BaseLayout
  title="Cookie Notice | Renol Foods"
  description="What the Renol Foods website stores in your browser: no analytics or advertising cookies, and no form data."
>
  <section class="relative py-20 lg:py-28 border-b border-white/10 font-body">
    <div class="section-container max-w-4xl relative z-10">
      <SectionHeading
        level={1}
        eyebrow="Legal"
        title="Cookie Notice"
        subtitle="This website uses no analytics or advertising cookies and collects no form data."
        align="left"
      />

      <div class="mt-12 bg-[#121214] p-8 sm:p-10 rounded-3xl border border-white/10 text-white/70 space-y-8 text-sm sm:text-base leading-relaxed">
        <section aria-labelledby="c-stored">
          <h2 id="c-stored" class="font-display text-xl font-bold text-white mb-2">What is stored in your browser</h2>
          <p>
            One entry, <code class="text-white">renol_notice_seen</code>, remembers that you have dismissed the cookie notice so
            it is not shown again. It stays on your device and is never sent to us. There are no forms on this website, so no
            form data is stored or collected.
          </p>
        </section>

        <section aria-labelledby="c-third">
          <h2 id="c-third" class="font-display text-xl font-bold text-white mb-2">Other services</h2>
          <p>
            The Contact page shows an embedded Google Map, and the contact buttons open WhatsApp, your phone's dialler or Google
            Maps. Those services may use their own cookies under their own policies.
          </p>
        </section>

        <section aria-labelledby="c-manage">
          <h2 id="c-manage" class="font-display text-xl font-bold text-white mb-2">Managing storage</h2>
          <p>
            You can clear site data for this website in your browser settings at any time. The cookie notice will then appear
            again on your next visit. See also the <a href="/privacy" class="underline text-white">Privacy Policy</a>.
          </p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
