---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Privacy Policy | Renol Foods"
  description="Privacy policy for the Renol Foods website: no forms, no form data collected."
>
  <section class="relative py-20 lg:py-28 border-b border-white/10 font-body">
    <div class="section-container max-w-4xl relative z-10">
      <SectionHeading
        level={1}
        eyebrow="Legal"
        title="Privacy Policy"
        subtitle="This website has no forms and collects no form data."
        align="left"
      />

      <div class="mt-12 bg-[#121214] p-8 sm:p-10 rounded-3xl border border-white/10 text-white/70 space-y-8 text-sm sm:text-base leading-relaxed">
        <section aria-labelledby="p-collect">
          <h2 id="p-collect" class="font-display text-xl font-bold text-white mb-2">What this website collects</h2>
          <p>
            The website has no forms. It does not ask for, or store, your name, email address, phone number or any message. It
            uses no analytics and no advertising cookies.
          </p>
        </section>

        <section aria-labelledby="p-contact">
          <h2 id="p-contact" class="font-display text-xl font-bold text-white mb-2">When you contact us</h2>
          <p>
            You can reach {site.name} by WhatsApp, by phone, or by opening our location in Google Maps. These buttons take you
            to WhatsApp, to your phone's dialler or to Google Maps. What you share there is handled by those services under
            their own terms, and we use anything you send us only to reply to you.
          </p>
        </section>

        <section aria-labelledby="p-map">
          <h2 id="p-map" class="font-display text-xl font-bold text-white mb-2">Embedded map</h2>
          <p>
            The Contact page shows an embedded Google Map. Loading it makes your browser connect to Google, which may set its
            own cookies.
          </p>
        </section>

        <section aria-labelledby="p-storage">
          <h2 id="p-storage" class="font-display text-xl font-bold text-white mb-2">Cookies and browser storage</h2>
          <p>
            The only item stored in your browser is a note that you have seen the cookie notice. See the
            <a href="/cookies" class="underline text-white">Cookie Notice</a> for details.
          </p>
        </section>

        <section aria-labelledby="p-questions">
          <h2 id="p-questions" class="font-display text-xl font-bold text-white mb-2">Questions</h2>
          <p>
            For any privacy question, call {site.phones[0].display}.
          </p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
