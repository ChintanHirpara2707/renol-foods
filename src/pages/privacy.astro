---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { siteConfig } from "../data/site";
---

<BaseLayout
  title="Privacy Policy | Renol Foods"
  description="Privacy and data protection policy for Renol Foods B2B inquiries and sample requests."
>
  <!-- Hero Section -->
  <section class="relative py-20 lg:py-28 border-b border-white/10 overflow-hidden font-body">
    <!-- Ambient Radial Glow -->
    <div
      class="pointer-events-none absolute left-1/2 top-10 -translate-x-1/2 w-[700px] h-[350px] rounded-full blur-[140px] opacity-20"
      style="background: radial-gradient(circle, #f59e0b 0%, transparent 70%);"
      aria-hidden="true"
    ></div>

    <div class="section-container max-w-4xl relative z-10">
      <SectionHeading
        eyebrow="Legal & Governance"
        title="Privacy Policy"
        subtitle="How Renol Foods handles commercial communications and sample dispatch data."
        align="left"
      />

      <!-- Hero Primary Action Button (1 per hero) -->
      <div class="mt-8 flex justify-start">
        <a href="/contact#sample-quote" class="btn-accent min-h-[44px]">
          Request a Sample
        </a>
      </div>

      <div class="mt-12 bg-[#121214] p-8 sm:p-10 rounded-3xl border border-white/10 text-white/70 space-y-5 text-sm sm:text-base leading-relaxed">
        <p>
          Renol Foods operates strictly as a Business-to-Business (B2B) food ingredient manufacturer based in Bavla, Ahmedabad. Information collected via this website (including names, corporate emails, phone numbers, application specifications, and delivery addresses) is used solely for processing product sample shipments, generating commercial quotes, and technical formulation follow-ups.
        </p>
        <p>
          We do not sell, rent, or trade your corporate contact information to third-party marketing entities. Any technical or formulation data shared under Non-Disclosure Agreements (NDAs) is protected with strict confidentiality standards.
        </p>
        <p>
          For any privacy inquiries or to update your business contact records, please reach our administrative desk directly at {siteConfig.contact.displayPhones[0]} or via our official contact channels.
        </p>
      </div>
    </div>
  </section>

  <!-- One Closing CTA Section Near the End of the Page -->
  <section class="py-20 bg-[#0e0e12] text-white text-center border-t border-white/10">
    <div class="section-container max-w-3xl">
      <span class="text-xs uppercase font-bold tracking-widest text-white/40 block mb-3 font-mono">B2B Manufacturing</span>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold mb-4 tracking-tight">
        Have questions regarding technical specifications?
      </h2>
      <p class="text-white/70 text-sm sm:text-base mb-8 max-w-xl mx-auto leading-relaxed font-body">
        Connect with our sales and quality desk in Bavla, Ahmedabad today.
      </p>
      <a href="/contact#sample-quote" class="btn-accent min-h-[44px]">
        Request a Sample
      </a>
    </div>
  </section>
</BaseLayout>
