---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/ui/Tag.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { products } from "../data/products";
import { categories, categoryById } from "../data/categories";

const searchText = (p: (typeof products)[number]) =>
  [p.name, categoryById(p.category).name, p.summary, ...p.uses].join(" ").toLowerCase();
---

<BaseLayout
  title="Products | Renol Foods"
  description={`Browse ${products.length} food powders from Renol Foods: fruit, vegetable, food colour, dairy, seasoning and beverage powders. Every product ships in a 20 kg corrugated box.`}
>
  <section class="catalogue" data-products>
    <div class="container">
      <SectionHeading
        level={1}
        eyebrow="Catalogue"
        title="Food Powders"
        subtitle="Fruit, vegetable, food colour, dairy, seasoning and beverage powders for food manufacturers."
        align="left"
      />

      <div class="toolbar">
        <div class="chips" role="group" aria-label="Filter by category">
          <button type="button" class="chip" data-filter="all" aria-pressed="true">All <span>{products.length}</span></button>
          {
            categories.map((c) => (
              <button type="button" class="chip" data-filter={c.hash} aria-pressed="false">
                {c.name} <span>{c.count}</span>
              </button>
            ))
          }
        </div>

        <div class="search" role="search">
          <label class="sr-only" for="product-search">Search products</label>
          <input id="product-search" type="search" placeholder="Search products" autocomplete="off" data-search />
        </div>
      </div>

      <p class="status" data-status aria-live="polite">Showing {products.length} of {products.length} products</p>

      <ul class="grid">
        {
          products.map((p, i) => {
            const category = categoryById(p.category);
            return (
              <li class="pcard" data-card data-category={category.hash} data-haystack={searchText(p)}>
                <a class="pcard__media" href={`/products/${p.slug}`} tabindex="-1" aria-hidden="true">
                  <img
                    src={p.image}
                    alt=""
                    width="500"
                    height="304"
                    loading={i < 4 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </a>
                <div class="pcard__body">
                  <h2>{p.name}</h2>
                  <div class="pcard__tags">
                    <Tag>{category.name}</Tag>
                    <Tag>{p.packaging}</Tag>
                  </div>
                  <a class="pcard__link" href={`/products/${p.slug}`} aria-label={`View details: ${p.name}`}>View details</a>
                </div>
              </li>
            );
          })
        }
      </ul>

      <p class="empty" data-empty hidden>No products match your search.</p>
    </div>
  </section>
</BaseLayout>

<script>
  import "../scripts/products-filter";
</script>

<style>
  .catalogue {
    padding-block: var(--s-16) var(--section-y);
  }
  .toolbar {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    margin-top: var(--s-8);
  }
  @media (min-width: 900px) {
    .toolbar {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    padding: 0 var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.05);
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
  }
  .chip span {
    color: var(--ink-2);
    font-size: var(--fs-small);
  }
  .chip:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  .chip[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .chip[aria-pressed="true"] span {
    color: var(--on-accent);
  }
  .search input {
    width: 100%;
    min-width: 16rem;
    min-height: var(--tap);
    padding: 0 var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
  }
  .search input::placeholder {
    color: var(--ink-3);
  }
  .status {
    margin-top: var(--s-6);
    color: var(--ink-3);
    font-size: var(--fs-small);
  }
  .grid {
    display: grid;
    gap: var(--s-4);
    margin: var(--s-4) 0 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 768px) {
    .grid {
      gap: var(--s-6);
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .pcard {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    border-radius: var(--r-card);
    background: var(--surface);
    /* skip rendering cards that are far off screen */
    content-visibility: auto;
    contain-intrinsic-size: auto 22rem;
  }
  .pcard[hidden] {
    display: none;
  }
  .pcard__media {
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 3;
    overflow: hidden;
    border-radius: var(--r-card) var(--r-card) 0 0;
    background: #f1efea;
  }
  .pcard__media img {
    display: block;
    width: 100%;
    max-width: 500px;
    height: 100%;
    object-fit: contain;
  }
  .pcard__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-4);
  }
  .pcard h2 {
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.2;
  }
  .pcard__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .pcard__tags :global(.tag) {
    padding: 0.15rem 0.6rem;
    font-size: 0.75rem;
  }
  .pcard__link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: var(--tap);
    margin-top: auto;
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--accent);
  }
  .empty {
    margin-top: var(--s-8);
    color: var(--ink-2);
  }
</style>
