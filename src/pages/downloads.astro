---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChatLink from "../components/ChatLink.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { legacyProducts as products } from "../data/legacy";
---

<BaseLayout
  title="Technical Documentation | Renol Foods Bavla"
  description="Request product specification sheets, Certificate of Analysis (COA) templates, and technical catalogs for Renol Foods' 8 industrial food powders."
>
  <!-- Hero Section -->
  <section
    class="relative py-20 lg:py-28 border-b border-white/10 overflow-hidden"
  >
    <!-- Ambient Radial Glow -->
    <div
      class="pointer-events-none absolute left-1/2 top-10 -translate-x-1/2 w-[700px] h-[350px] rounded-full blur-[140px] opacity-20"
      style="background: radial-gradient(circle, #a855f7 0%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="section-container relative z-10">
      <SectionHeading
        level={1}
        eyebrow="Technical Resources"
        title="Specification Sheets"
        subtitle="Access technical data, parameter sheets, and documentation checklists for our spray-dried food powder portfolio."
      />

      <!-- Hero Primary Action Button (1 per hero) -->
      <div class="mt-8 flex justify-center">
        <ChatLink class="btn-accent min-h-[44px]" />
      </div>

      <!-- Core Download Items: 3 cols desktop, 2 tablet, 1 mobile -->
      <!-- <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div
          class="p-8 rounded-3xl bg-[#121214] border border-white/10 flex flex-col justify-between"
        >
          <div>
            <div
              class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-amber-400 font-display font-bold text-lg mb-4"
            >
              PDF
            </div>
            <h2 class="font-display text-2xl font-bold text-white mb-2">
              Corporate Product Catalog
            </h2>
