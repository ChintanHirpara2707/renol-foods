---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import MobileBottomBar from "../components/MobileBottomBar.astro";
import CookieNotice from "../components/CookieNotice.astro";
import { siteConfig } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
}

const {
  title = `${siteConfig.name} | Industrial Food Powder Manufacturer, Bavla, Gujarat`,
  description = siteConfig.description,
  ogImage = "/images/Logo.png",
  canonicalUrl = Astro.url.href,
  noindex = false,
} = Astro.props;

const siteTitle = title.includes(siteConfig.name) ? title : `${title} | ${siteConfig.name}`;
const logoFullUrl = new URL("/images/Logo.png", Astro.site || Astro.url.origin).href;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.name,
  legalName: siteConfig.legalName,
  url: new URL("/", Astro.site || Astro.url.origin).href,
  logo: logoFullUrl,
  description: siteConfig.description,
  foundingDate: "2021",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Plot No. 616, Kerala GIDC",
    addressLocality: "Bavla, Ahmedabad",
    addressRegion: "Gujarat",
    addressCountry: "IN",
  },
  contactPoint: {
    "@type": "ContactPoint",
    telephone: siteConfig.contact.phones[0] || "+919979977396",
    contactType: "sales",
    areaServed: "Global",
  },
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site || Astro.url.origin)} />
    <meta property="og:site_name" content={siteConfig.name} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={siteTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.site || Astro.url.origin)} />

    <!-- Organization Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <!-- Preconnect to static assets -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-[#0b0b0d] text-white min-h-screen flex flex-col font-body selection:bg-white/20 selection:text-white">
    <!-- Skip to main content for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-green-black focus:text-cream focus:rounded-md focus:shadow-lg focus:outline-none"
    >
      Skip to main content
    </a>

    <!-- Sticky Header -->
    <Header />

    <!-- Main Content Region -->
    <main id="main-content" class="flex-grow w-full">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Floating Global Actions -->
    <WhatsAppButton />
    <MobileBottomBar />
    <CookieNotice />

    <!-- Lenis Smooth Scrolling Initialization -->
    <script>
      import Lenis from "lenis";

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!prefersReducedMotion) {
        const lenis = new Lenis({
          duration: 1.1,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: "vertical",
          gestureOrientation: "vertical",
          smoothWheel: true,
          touchMultiplier: 1.5,
        });

        (window as unknown as { lenis: Lenis }).lenis = lenis;

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);

        // Intercept anchor hash links for smooth scrolling via Lenis
        document.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          const anchor = target.closest("a");
          if (anchor && anchor.hash && anchor.origin === window.location.origin && anchor.pathname === window.location.pathname) {
            const targetElement = document.querySelector(anchor.hash);
            if (targetElement) {
              e.preventDefault();
              lenis.scrollTo(targetElement, { offset: -80 });
            }
          }
        });
      }
    </script>
  </body>
</html>
